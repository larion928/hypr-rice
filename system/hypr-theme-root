#!/bin/bash
# hypr-theme-root — the only root actions changetheme needs; allowed without a password by
# /etc/sudoers.d/hypr-theme. Root never reads the user's files here: colours, font and the
# wallpaper path arrive as arguments and are only checked for format.
#   hypr-theme-root folders <papirus colour>
#   hypr-theme-root sddm <wallpaper path> <accent #rrggbb> <bg #rrggbb> <fg #rrggbb> <font>
#   hypr-theme-root browser-policy-off   remove the colour policy older versions set for
#                                        Chromium-based browsers (it locks out theme extensions)
#   hypr-theme-root power saver|balanced|performance   CPU boost and governor, GPU power level
#   hypr-theme-root battery-care on|off  Lenovo IdeaPad conservation mode: charge stops at ~60%
# power and battery-care also write a tmpfiles.d entry so the choice survives a reboot.
set -eu
THEMES=__HOME__/.config/hypr/themes
SDDM_THEME=/usr/share/sddm/themes/sugar-candy

die() { echo "hypr-theme-root: $*" >&2; exit 2; }
hex() { [[ $1 =~ ^#[0-9a-fA-F]{6}$ ]] || die "bad colour: $1"; }

case "${1:-}" in
folders)
    case "${2:-}" in
        adwaita|black|blue|bluegrey|breeze|brown|carmine|cyan|darkcyan|deeporange|green|grey|indigo|\
        magenta|nordic|orange|palebrown|paleorange|pink|red|teal|violet|white|yaru|yellow) ;;
        *) die "bad folder colour" ;;
    esac
    exec /usr/bin/papirus-folders -C "$2" -t Papirus-Dark
    ;;
sddm)
    [ $# -eq 6 ] || die "usage: sddm WALLPAPER ACCENT BG FG FONT"
    wall=$2
    # String checks only: the greeter (user sddm) is the one that opens the file.
    # Any name (wallpapers may be Cyrillic) except what could break the quoted config value.
    [[ $wall == "$THEMES"/* && $wall != *..* && ! $wall =~ [\"\\\$\`[:cntrl:]] && $wall =~ \.(png|jpg|jpeg|webp)$ ]] \
        || die "wallpaper must be an image under $THEMES"
    hex "$3"; hex "$4"; hex "$5"
    [[ $6 =~ ^[A-Za-z0-9\ ._-]{1,64}$ ]] || die "bad font name"
    cat > "$SDDM_THEME/theme.conf.user" <<CONF
# Written by hypr-theme-root (changetheme). Overrides theme.conf.
[General]
Background="file://$wall"
MainColor="$5"
AccentColor="$3"
BackgroundColor="$4"
Font="$6"
HeaderText=""
CONF
    chmod 644 "$SDDM_THEME/theme.conf.user"
    if [ ! -f /etc/sddm.conf.d/10-theme.conf ]; then
        mkdir -p /etc/sddm.conf.d
        printf '[Theme]\nCurrent=sugar-candy\n' > /etc/sddm.conf.d/10-theme.conf
    fi
    ;;
browser-policy-off)
    [ $# -eq 1 ] || die "usage: browser-policy-off"
    rm -f /etc/chromium/policies/managed/hypr-rice.json /etc/brave/policies/managed/hypr-rice.json \
          /etc/opt/chrome/policies/managed/hypr-rice.json
    ;;
power)
    [ $# -eq 2 ] || die "usage: power saver|balanced|performance"
    # This laptop's firmware has no CPPC, so amd-pstate and platform profiles are out; acpi-cpufreq
    # still offers turbo boost and the governor, amdgpu its DPM level.
    case "$2" in
        saver)       boost=0 governor=schedutil   gpu=low ;;
        balanced)    boost=1 governor=schedutil   gpu=auto ;;
        performance) boost=1 governor=performance gpu=auto ;;
        *) die "bad profile" ;;
    esac
    conf=/etc/tmpfiles.d/hypr-rice-power.conf
    {
        echo "# Power profile \"$2\", written by hypr-theme-root (power-mode)."
        [ -e /sys/devices/system/cpu/cpufreq/boost ] && echo "w /sys/devices/system/cpu/cpufreq/boost - - - - $boost"
        echo "w /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor - - - - $governor"
        echo "w /sys/class/drm/card*/device/power_dpm_force_performance_level - - - - $gpu"
    } > "$conf"
    systemd-tmpfiles --create "$conf" 2>/dev/null || true
    ;;
battery-care)
    [ $# -eq 2 ] || die "usage: battery-care on|off"
    case "$2" in on) value=1 ;; off) value=0 ;; *) die "bad value" ;; esac
    ls /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode >/dev/null 2>&1 || die "no IdeaPad conservation mode here"
    conf=/etc/tmpfiles.d/hypr-rice-battery.conf
    printf '# Battery conservation mode, written by hypr-theme-root (power-mode).\nw /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode - - - - %s\n' "$value" > "$conf"
    systemd-tmpfiles --create "$conf"
    ;;
*)
    die "unknown command"
    ;;
esac
