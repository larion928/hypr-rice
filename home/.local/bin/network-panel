#!/bin/bash
# network-panel — toggle the themed network panel (~/.config/quickshell/network): Wi-Fi list,
# passwords, current connection. Opened by a click on the network in waybar or from the launcher.
CONF="$HOME/.config/quickshell/network"
# Already open: ask it to close. No lock file: anything it starts would inherit the lock fd.
if quickshell list -p "$CONF" 2>/dev/null | grep -q "Process ID"; then
    quickshell ipc -p "$CONF" call network close >/dev/null 2>&1 || quickshell kill -p "$CONF" >/dev/null 2>&1
    exit 0
fi
THEME=$(cat "$HOME/.config/hypr/current-theme" 2>/dev/null || echo claude)
export NET_THEME_DIR="$HOME/.config/hypr/themes/$THEME"
exec quickshell -n -p "$CONF"
