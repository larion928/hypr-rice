#!/usr/bin/env python3
"""TUI for adjusting Hyprland mouse sensitivity live + persisting to devices.lua."""
import curses
import json
import re
import subprocess
from pathlib import Path

# Required from hyprland.lua; one hl.device({...}) call per line.
CONF = Path.home() / ".config/hypr/devices.lua"
STEP = 0.05


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True)


def get_mice():
    out = hyprctl("devices", "-j").stdout
    data = json.loads(out)
    mice = [m["name"] for m in data.get("mice", []) if "keyboard" not in m["name"]]
    return mice


def device_line_re(device):
    return re.compile(
        r'^hl\.device\(\{\s*name\s*=\s*"' + re.escape(device)
        + r'"\s*,\s*sensitivity\s*=\s*(-?[\d.]+)\s*\}\)\s*$',
        re.MULTILINE,
    )


def global_sensitivity():
    out = hyprctl("repl", 'return hl.get_config("input.sensitivity")').stdout.strip()
    try:
        return float(out)
    except ValueError:
        return 0.0


def read_conf_sensitivity(device):
    text = CONF.read_text() if CONF.exists() else ""
    m = device_line_re(device).search(text)
    return float(m.group(1)) if m else global_sensitivity()


def device_line(device, value):
    return f'hl.device({{ name = "{device}", sensitivity = {value:.2f} }})'


def apply_live(device, value):
    # hyprctl keyword is not supported by the Lua config manager.
    hyprctl("eval", device_line(device, value))


def save_conf(device, value):
    text = CONF.read_text() if CONF.exists() else ""
    line = device_line(device, value)
    pat = device_line_re(device)
    if pat.search(text):
        text = pat.sub(lambda _: line, text)
    else:
        text = text.rstrip("\n") + ("\n" if text else "") + line + "\n"
    CONF.write_text(text)


def clamp(v):
    return max(-1.0, min(1.0, round(v, 2)))


def main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(False)
    mice = get_mice()
    if not mice:
        stdscr.addstr(0, 0, "No mice found via hyprctl devices.")
        stdscr.getch()
        return

    idx = 0
    value = read_conf_sensitivity(mice[idx])
    saved_msg = ""

    while True:
        stdscr.clear()
        stdscr.addstr(0, 0, "Hyprland Mouse Sensitivity", curses.A_BOLD)
        stdscr.addstr(1, 0, "Tab: switch device | Up/Down or +/-: adjust | s: save | q: quit")
        stdscr.addstr(3, 0, f"Device: {mice[idx]}")
        bar_width = 40
        pos = int((value + 1.0) / 2.0 * bar_width)
        bar = "[" + "#" * pos + "-" * (bar_width - pos) + "]"
        stdscr.addstr(5, 0, f"Sensitivity: {value:+.2f}")
        stdscr.addstr(6, 0, bar)
        stdscr.addstr(8, 0, saved_msg)
        stdscr.refresh()

        key = stdscr.getch()
        saved_msg = ""
        if key in (curses.KEY_UP, ord("+"), ord("=")):
            value = clamp(value + STEP)
            apply_live(mice[idx], value)
        elif key in (curses.KEY_DOWN, ord("-")):
            value = clamp(value - STEP)
            apply_live(mice[idx], value)
        elif key == ord("\t"):
            idx = (idx + 1) % len(mice)
            value = read_conf_sensitivity(mice[idx])
            apply_live(mice[idx], value)
        elif key == ord("s"):
            save_conf(mice[idx], value)
            saved_msg = f"Saved to {CONF}"
        elif key == ord("q"):
            break


if __name__ == "__main__":
    curses.wrapper(main)
