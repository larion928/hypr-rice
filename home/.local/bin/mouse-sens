#!/usr/bin/env python3
"""TUI for adjusting Hyprland mouse sensitivity live + persisting to devices.lua."""
import curses
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".config/hypr/scripts"))
import devices_lua  # noqa: E402
import mice  # noqa: E402

STEP = 0.05


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True)


def get_mice():
    """Hyprland's pointers that are real devices: no virtual ones (ydotoold), no media-key nodes."""
    listed = [mouse["name"] for mouse in json.loads(hyprctl("devices", "-j").stdout).get("mice", [])]
    real = [pointer.name for pointer in mice.pointers()]
    return [name for name in listed if any(mice.same_device(name, pointer) for pointer in real)]


def global_sensitivity():
    out = hyprctl("repl", 'return hl.get_config("input.sensitivity")').stdout.strip()
    try:
        return float(out)
    except ValueError:
        return 0.0


def read_conf_sensitivity(device):
    return devices_lua.read().get(device, {}).get("sensitivity", global_sensitivity())


def apply_live(device, value):
    # hyprctl keyword is not supported by the Lua config manager. The device's other settings go along,
    # so a rotation saved by rice mouse-test stays applied.
    settings = devices_lua.read().get(device, {}) | {"sensitivity": value}
    hyprctl("eval", devices_lua.device_line(device, settings))


def save_conf(device, value):
    devices_lua.save(device, {"sensitivity": value})


def clamp(v):
    return max(-1.0, min(1.0, round(v, 2)))


def main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(False)
    devices = get_mice()
    if not devices:
        stdscr.addstr(0, 0, "No mice found via hyprctl devices.")
        stdscr.getch()
        return

    idx = 0
    value = read_conf_sensitivity(devices[idx])
    saved_msg = ""

    while True:
        stdscr.clear()
        stdscr.addstr(0, 0, "Hyprland Mouse Sensitivity", curses.A_BOLD)
        stdscr.addstr(1, 0, "Tab: switch device | Up/Down or +/-: adjust | s: save | q: quit")
        stdscr.addstr(3, 0, f"Device: {devices[idx]}")
        bar_width = 40
        pos = int((value + 1.0) / 2.0 * bar_width)
        bar = "[" + "#" * pos + "-" * (bar_width - pos) + "]"
        stdscr.addstr(5, 0, f"Sensitivity: {value:+.2f}")
        stdscr.addstr(6, 0, bar)
        stdscr.addstr(8, 0, saved_msg)
        stdscr.refresh()

        key = stdscr.getch()
        saved_msg = ""
        if key in (curses.KEY_UP, ord("+"), ord("=")):
            value = clamp(value + STEP)
            apply_live(devices[idx], value)
        elif key in (curses.KEY_DOWN, ord("-")):
            value = clamp(value - STEP)
            apply_live(devices[idx], value)
        elif key == ord("\t"):
            idx = (idx + 1) % len(devices)
            value = read_conf_sensitivity(devices[idx])
            apply_live(devices[idx], value)
        elif key == ord("s"):
            save_conf(devices[idx], value)
            saved_msg = f"Saved to {devices_lua.PATH}"
        elif key == ord("q"):
            break


if __name__ == "__main__":
    curses.wrapper(main)
