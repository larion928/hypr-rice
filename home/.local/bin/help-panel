#!/bin/bash
# help-panel — toggle the themed cheat sheet (~/.config/quickshell/help), Alt+F1 or waybar "?".
# Hotkeys come live from `hyprctl binds` (their descriptions in keybind.lua).
CONF="$HOME/.config/quickshell/help"
# Already open: ask it to close. No lock file: anything the overlay starts (changetheme ->
# waybar, apps from the launcher) would inherit the lock fd and keep it forever.
if quickshell list -p "$CONF" 2>/dev/null | grep -q "Process ID"; then
    quickshell ipc -p "$CONF" call help close >/dev/null 2>&1 || quickshell kill -p "$CONF" >/dev/null 2>&1
    exit 0
fi
THEME=$(cat "$HOME/.config/hypr/current-theme" 2>/dev/null || echo claude)
export HELP_THEME_DIR="$HOME/.config/hypr/themes/$THEME"
export HELP_BINDS="${XDG_RUNTIME_DIR:-/tmp}/help-binds.json"
hyprctl binds -j > "$HELP_BINDS"
exec quickshell -n -p "$CONF"
