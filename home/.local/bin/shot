#!/bin/bash
# shot — themed screenshot. Freezes every output with grim, then the overlay (menu "shot" of
# ~/.config/quickshell/shell) lets you pick a region in the current theme's style.
#   shot          select a region (click a window to take just that window)
#   shot full     whole focused monitor
#   shot ocr      select a region; its text (tesseract) goes to the clipboard instead      Alt+Shift+Print
#   shot color    the colour picker: a click copies a pixel's colour as #rrggbb             Alt+Shift+C
# A shot goes to ~/Pictures/screenshots/ and to the clipboard. ocr and color are features (Alt+F2 → Функции).
set -u

MODE=${1:-region}
MENU=shot
case "$MODE" in
    ocr)   FEATURE=ocr;          FEATURE_NAME="Распознавание текста"; FEATURE_OFF="Распознавание текста выключено" ;;
    color) FEATURE=color-picker; FEATURE_NAME="Пипетка";              FEATURE_OFF="Пипетка выключена"; MENU=picker ;;
    *)     FEATURE="" ;;
esac
if [ -n "$FEATURE" ] && ! python3 "$HOME/.config/hypr/scripts/features.py" is "$FEATURE"; then
    notify-send -a "$FEATURE_NAME" "$FEATURE_OFF" "Включить: Alt+F2 → Функции"
    exit 0
fi

OUTDIR="$HOME/Pictures/screenshots"
RUN="${XDG_RUNTIME_DIR:-/tmp}/shot"

# One overlay at a time; checked before grim so a second press never captures the overlay.
source "$HOME/.config/quickshell/menus.sh"
if [ "$(menus_call isOpen shot)" = true ] || [ "$(menus_call isOpen picker)" = true ]; then
    exit 0
fi

mkdir -p "$OUTDIR"
rm -rf "$RUN"
mkdir -p "$RUN"

hyprctl monitors -j > "$RUN/monitors.json"
hyprctl clients -j > "$RUN/clients.json"

# Capture before the overlay maps, otherwise it would end up in the shot.
for out in $(jq -r '.[].name' "$RUN/monitors.json"); do
    # Uncompressed: the frame is temporary and compression makes grim ~15x slower.
    grim -l 0 -o "$out" "$RUN/$out.png" &
done
wait

# SHOT_THEME=<theme> draws the overlay with that theme's screenshot.qml (for trying one out).
menus_call open "$MENU" "$MODE${SHOT_THEME:+:$SHOT_THEME}"
