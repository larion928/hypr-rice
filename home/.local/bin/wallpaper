#!/bin/bash
# wallpaper FILE — puts FILE on the desktop: a picture through awww; an animation (a GIF or a video)
# as an mp4 played by mpvpaper, decoded by the GPU, looping, paused while fullscreen windows
# hide it. Under the animation awww shows its first frame: what is seen while the video loads, and
# if mpvpaper stops. Without mpvpaper a GIF is played by awww and a video shows its first frame.
# changetheme, the settings window and the Hyprland autostart all set wallpapers through this.
set -u
file=${1:?usage: wallpaper FILE}
THEMEGEN="$HOME/.config/hypr/scripts/themegen.py"
PLAYER=${WALLPAPER_PLAYER:-mpvpaper}  # the tests put a stand-in here, so they never start the real one

# One at a time (changetheme, the settings window and Hyprland's autostart may overlap): two runs that
# both stop the old player before either starts its own would leave two players. The player is
# started without the lock's descriptor: it would hold the lock for as long as it plays.
exec {lock}>"${XDG_RUNTIME_DIR:-/tmp}/hypr-rice-wallpaper.lock"
flock -w 30 "$lock" || { echo "wallpaper: другой запуск не закончился за 30 с" >&2; exit 1; }

case "${file,,}" in
    *.gif|*.mp4|*.webm|*.mkv|*.mov|*.avi|*.m4v) animated=1 ;;
    *) animated=0 ;;
esac

pkill -x "$(basename "$PLAYER")" 2>/dev/null
if [ "$animated" = 0 ]; then
    awww img "$file"
    exit
fi

mapfile -t play < <(python3 "$THEMEGEN" wallpaper-play "$file")
still=${play[0]:-}
video=${play[1]:-}
if ! command -v "$PLAYER" >/dev/null; then
    case "${file,,}" in
        *.gif) awww img "$file" ;;
        *) [ -n "$still" ] && awww img "$still" ;;
    esac
    notify-send -a hypr-rice "Анимированные обои: нужен mpvpaper" \
        "Пока виден первый кадр. Поставить: Alt+F2 → Тема → Обои, там предложат установку" 2>/dev/null
    exit
fi
[ -n "$still" ] && awww img "$still"
[ -n "$video" ] || exit 1
# The bottom layer: above awww's background, below every window and the bar. -p pauses it while
# Hyprland stops drawing it. A fullscreen window on the workspace a monitor shows pauses it through the
# control socket: the Hyprland config watches for that and runs wallpaper-hidden. (mpvpaper's own -a FULL
# paused it for a fullscreen window on any workspace, hidden ones too.) It starts silent: the shell's
# services/Wallpaper.qml turns a clip's sound on and fades it in when the user wants the wallpaper's sound.
control="${XDG_RUNTIME_DIR:-/tmp}/hypr-rice-wallpaper.sock"
exec "$PLAYER" -f -p -l bottom \
    -o "aid=no volume=0 audio-client-name=hypr-rice-wallpaper loop hwdec=auto panscan=1.0 input-ipc-server=$control" \
    ALL "$video" {lock}>&-
