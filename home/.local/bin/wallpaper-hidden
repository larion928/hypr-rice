#!/usr/bin/env python3
"""wallpaper-hidden yes|no — the Hyprland config runs it when fullscreen windows come to hide the animated
wallpaper on every monitor, or stop hiding it. The shell (services/Wallpaper.qml) fades the wallpaper's
sound out or in and pauses or resumes it; it answers "ok". Without a running shell the wallpaper is paused
here, through the mpv control socket that ~/.local/bin/wallpaper gives mpvpaper, when the feature
wallpaper-pause is on. A picture wallpaper, or a player that is gone, has no socket to answer: then there
is nothing to pause."""
import json
import os
import socket
import subprocess
import sys
from pathlib import Path

HIDDEN = {"yes": True, "no": False}
if len(sys.argv) != 2 or sys.argv[1] not in HIDDEN:
    sys.exit("usage: wallpaper-hidden yes|no")
hidden = HIDDEN[sys.argv[1]]
home = Path.home()


def told_the_shell():
    try:
        answer = subprocess.run(["quickshell", "ipc", "-p", str(home / ".config/quickshell/shell"), "call",
                                 "wallpaper", "hidden", str(hidden).lower()],
                                capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    # quickshell exits 0 even when no shell has the target: only the answer tells.
    return answer.stdout.strip() == "ok"


def pause_wanted():
    features = home / ".config/hypr/scripts/features.py"
    return subprocess.run([sys.executable, str(features), "is", "wallpaper-pause"]).returncode == 0


def set_pause(paused):
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr-rice-wallpaper.sock")
    command = {"command": ["set_property", "pause", paused]}
    with socket.socket(socket.AF_UNIX) as player:
        player.settimeout(2)
        try:
            player.connect(path)
        except (FileNotFoundError, ConnectionRefusedError):
            return
        player.sendall(json.dumps(command).encode() + b"\n")
        # mpv's answer: closing before it could leave the command unread.
        player.recv(4096)


if not told_the_shell():
    set_pause(hidden and pause_wanted())
