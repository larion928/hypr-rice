#!/bin/bash
# shots-gallery — toggle the themed gallery of ~/Pictures/screenshots (~/.config/quickshell/shots).
CONF="$HOME/.config/quickshell/shots"
if quickshell list -p "$CONF" 2>/dev/null | grep -q "Process ID"; then
    quickshell ipc -p "$CONF" call shots close >/dev/null 2>&1 || quickshell kill -p "$CONF" >/dev/null 2>&1
    exit 0
fi
THEME=$(cat "$HOME/.config/hypr/current-theme" 2>/dev/null || echo claude)
export SHOTS_THEME_DIR="$HOME/.config/hypr/themes/$THEME"
export SHOTS_DIR="$HOME/Pictures/screenshots"
mkdir -p "$SHOTS_DIR"
exec quickshell -n -p "$CONF"
