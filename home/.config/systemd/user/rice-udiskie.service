[Unit]
Description=Automount of USB drives and memory cards (udiskie, ~/.config/udiskie/config.yml)
# Hyprland 0.57+ starts hyprland-session.target itself; udiskie needs its Wayland display for the tray icon
# and the password window of an encrypted drive. Under uwsm Hyprland leaves the target alone.
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
ExecStart=%h/.local/bin/rice-automount
# A start before Hyprland has handed WAYLAND_DISPLAY to systemd fails and is retried. Quit in the tray menu
# exits cleanly and stays quit until the next login.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
