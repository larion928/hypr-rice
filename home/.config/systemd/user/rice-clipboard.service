[Unit]
Description=Clipboard history for the clipboard menu (Alt+Shift+V)
# Hyprland 0.57+ starts hyprland-session.target itself, so the history is kept only under Hyprland and stops
# with it. Under uwsm Hyprland leaves the target alone and the history is not kept.
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
ExecStart=/usr/bin/wl-paste --watch %h/.local/bin/clipboard-store
# Hyprland starts the target right after handing WAYLAND_DISPLAY to systemd, without waiting for it: a start
# that came too early fails and is retried.
Restart=always
RestartSec=1

[Install]
WantedBy=hyprland-session.target
