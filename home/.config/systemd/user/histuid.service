[Unit]
Description=histuid notification daemon
Documentation=https://github.com/jmylchreest/histui
After=graphical-session.target
# no PartOf/WantedBy=graphical-session.target: that target refuses manual start
# and never activates under Hyprland, so the daemon never autostarted.
StartLimitIntervalSec=0

[Service]
Type=simple
# Started only from Hyprland: another desktop's daemon may hold the notification bus name
# (D-Bus activates mako and the like on the first notification), so it goes first.
ExecStartPre=-/usr/bin/pkill -x mako|dunst|swaync
ExecStart=/usr/bin/histuid --theme cyberpunk
# auto-restart every 30 minutes
RuntimeMaxSec=1800
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
