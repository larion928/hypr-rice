#!/usr/bin/env bash
# rice — install and manage hypr-rice.
#
#   rice              menu
#   rice install      install or reinstall the rice (what install.sh runs)
#   rice apps         pick programs to install
#   rice remove       remove programs installed from the catalog
#   rice update       fetch the latest rice from GitHub and apply it (keeps theme and machine files)
#   rice upgrade      update the system, the hypr-rice repo and AUR programs
#   rice proton       pick the Proton version that runs .exe files
#   rice games        game optimisations, each on or off: GameMode, NTSync, tearing, linux-zen
#   rice repair       re-apply SDDM, GTK theme and services
#   rice report       write ~/rice-report.txt for whoever helps you debug
#   rice doctor       check the system and the rice; --fix [-y] cures, --full slow checks too (rice doctor -h)
#   rice uninstall    remove the rice and put the last backup back
#
# Environment: RICE_THEME, RICE_ASSUME=y|n, RICE_APPS=all|none|id,id, RICE_MODE=replace|coexist
# (see install.sh).
set -euo pipefail

SRC=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# Updates follow the branch the rice was installed from.
BRANCH="${RICE_BRANCH:-$(git -C "$SRC" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)}"
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP="$HOME/.rice-backup-$STAMP"
MARKER="$HOME/.config/hypr/.rice-installed"
CACHE="$HOME/.cache/hypr-rice"
# The author's commit signing key, remembered at the first install. It lives outside the repo, so a
# pushed change of system/allowed_signers cannot move the trust along with a malicious update.
TRUST="$HOME/.config/hypr-rice/allowed_signers"
PKG_REPO_URL="https://github.com/larion928/hypr-rice-pkgs/releases/download/repo"
PKG_KEY_FPR=E9E510D6FB25450E897102A01CEA86E55DC9094D
# Not every login sets USER (a bare `su`, some containers); set -u would stop rice at its first use.
USER=${USER:-$(id -un)}

# ---------- output ----------

if [ -t 1 ]; then
    B=$'\e[1m'; RED=$'\e[31m'; GRN=$'\e[32m'; YEL=$'\e[33m'; CYN=$'\e[36m'; R=$'\e[0m'
else
    B=; RED=; GRN=; YEL=; CYN=; R=
fi
step() { printf '\n%s==>%s %s%s%s\n' "$CYN" "$R" "$B" "$*" "$R"; }
info() { printf '    %s\n' "$*"; }
ok()   { printf '    %s✓%s %s\n' "$GRN" "$R" "$*"; }
warn() { printf '    %s!%s %s\n' "$YEL" "$R" "$*" >&2; WARNINGS+=("$*"); }
die()  { printf '\n%sОшибка:%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }
WARNINGS=()

# curl | bash: stdin is the script itself, so questions are read from the terminal.
have_tty() { { : </dev/tty; } 2>/dev/null; }
ask() {  # ask "question" default(y|n) -> returns 0 for yes
    local q=$1 def=${2:-n} a hint
    [ "$def" = y ] && hint="[Y/n]" || hint="[y/N]"
    if [ -n "${RICE_ASSUME:-}" ]; then
        info "$q $hint ${RICE_ASSUME} (RICE_ASSUME)"
        [[ $RICE_ASSUME =~ ^[Yy] ]]
        return
    fi
    if ! have_tty; then
        [ "$def" = y ]
        return
    fi
    read -r -p "    $q $hint " a </dev/tty || a=""
    a=${a:-$def}
    [[ $a =~ ^[YyДд] ]]
}

# A comment starts a line or follows a space: a "#" inside an entry (appimage:URL#sha256=…) is the entry's.
list() {  # entries of a list file, without comments
    grep -v '^[[:space:]]*#' "$1" | sed 's/[[:space:]]\+#.*//' | grep -v '^[[:space:]]*$'
}
trim() { local v=$1; v=${v#"${v%%[![:space:]]*}"}; printf '%s' "${v%"${v##*[![:space:]]}"}"; }

need_sudo() {
    [ "$(id -u)" -ne 0 ] || die "запускай от обычного пользователя, не от root (sudo спросят сам)"
    if ! sudo -n true 2>/dev/null; then
        info "Нужны права администратора, введи пароль sudo:"
        if have_tty; then sudo -v </dev/tty; else sudo -v; fi || die "sudo не сработал"
    fi
    # Keep the sudo timestamp fresh for the whole (long) run.
    if [ -z "${SUDO_KEEPER:-}" ]; then
        ( while kill -0 $$ 2>/dev/null; do sudo -n true 2>/dev/null; sleep 50; done ) &
        SUDO_KEEPER=$!
        trap 'kill $SUDO_KEEPER 2>/dev/null || true' EXIT
    fi
}

# ---------- gum (menus and the program checklist) ----------

# Pinned and checksummed: gum 2.x toggles only with "x", 0.17 also with space. The checksum is the
# x86_64 build's; on other machines, and wherever GitHub is unreachable, menus are numbered lists.
GUM_VERSION=0.17.0
GUM_SHA256=69ee169bd6387331928864e94d47ed01ef649fbfe875baed1bbf27b5377a6fdb
GUM=""
GUM_MISSING=0  # gum could not be had: not tried again in this run
fetch_gum() {
    [ -n "$GUM" ] && return 0
    [ "$GUM_MISSING" = 0 ] || return 1
    local dir="$CACHE/gum-$GUM_VERSION" tgz
    if [ "$(uname -m)" != x86_64 ]; then
        info "меню gum есть только для x86_64, выбор — номерами" >&2
        GUM_MISSING=1
        return 1
    fi
    if [ ! -x "$dir/gum" ]; then
        mkdir -p "$dir"
        tgz="$dir/gum.tgz"
        if ! curl -fsSL --max-time 60 -o "$tgz" \
                "https://github.com/charmbracelet/gum/releases/download/v$GUM_VERSION/gum_${GUM_VERSION}_Linux_x86_64.tar.gz" \
            || ! echo "$GUM_SHA256  $tgz" | sha256sum -c --quiet - >/dev/null 2>&1 \
            || ! tar -xzf "$tgz" -C "$dir" --strip-components=1; then
            rm -rf "$dir"
            info "меню gum не скачалось с GitHub, выбор — номерами" >&2
            GUM_MISSING=1
            return 1
        fi
    fi
    GUM="$dir/gum"
}
GUM_STYLE=(--header.foreground "#d97757" --cursor.foreground "#e8a383" --selected.foreground "#8fa876")

# Menus. Options are "label=value"; the chosen values are printed, one per line. With gum the list
# is navigated with arrows; without it (see fetch_gum) it is numbered and answered with numbers.
# Both draw on the terminal, so the caller's $(...) captures only the values.
choose_one() {  # choose_one HEADER OPTION...: fails when nothing was chosen
    local header=$1 n
    shift
    have_tty || return 1
    if fetch_gum; then
        "$GUM" choose --height "$(gum_height $#)" --header "$header" --cursor "› " "${GUM_STYLE[@]}" \
            --label-delimiter="=" "$@" </dev/tty
        return
    fi
    numbered_list "$header" "" "$@"
    read -r -p "    Номер, Enter — отмена: " n </dev/tty || return 1
    option_value "$n" "$@"
}

choose_many() {  # choose_many HEADER SELECTED OPTION...; SELECTED: labels ticked from the start, comma-separated
    local header=$1 selected=$2 nums n
    shift 2
    have_tty || return 1
    if fetch_gum; then
        "$GUM" choose --no-limit --height "$(gum_height $#)" --label-delimiter="=" \
            --header "$header  пробел — отметить · enter — готово" \
            --selected "$selected" --cursor "› " --cursor-prefix "[ ] " --selected-prefix "[✓] " \
            --unselected-prefix "[ ] " "${GUM_STYLE[@]}" "$@" </dev/tty
        return
    fi
    numbered_list "$header" "$selected" "$@"
    read -r -p "    Номера через пробел (0 — ничего), Enter — оставить отмеченное: " nums </dev/tty || return 1
    if [ -z "$nums" ]; then
        local option
        for option in "$@"; do
            [[ ",$selected," == *",${option%=*},"* ]] && echo "${option##*=}"
        done
        return 0
    fi
    for n in $nums; do option_value "$n" "$@" || true; done
}

gum_height() { local rows=$(($1 + 2)); echo $((rows < 22 ? rows : 22)); }

numbered_list() {  # numbered_list HEADER SELECTED OPTION...: the fallback menu, on the terminal
    local header=$1 selected=$2 i=1 option mark=""
    shift 2
    printf '    %s\n' "$header" >&2
    for option in "$@"; do
        if [ -n "$selected" ]; then
            mark="[ ] "
            [[ ",$selected," == *",${option%=*},"* ]] && mark="[✓] "
        fi
        printf '      %2d) %s%s\n' "$i" "$mark" "${option%=*}" >&2
        i=$((i + 1))
    done
}

option_value() {  # option_value N OPTION...: the value of option number N
    local n=$1
    shift
    if ! [[ $n =~ ^[0-9]+$ ]] || [ "$n" -lt 1 ] || [ "$n" -gt $# ]; then
        return 1
    fi
    local option=${!n}
    echo "${option##*=}"
}

# ---------- packages: official repos with mirror fallback ----------

# Mirrors that answered well from Russia and Europe; used when the configured ones fail.
FALLBACK_MIRRORS=(
    "https://mirror.yandex.ru/archlinux/\$repo/os/\$arch"
    "https://mirror.truenetwork.ru/archlinux/\$repo/os/\$arch"
    "https://geo.mirror.pkgbuild.com/\$repo/os/\$arch"
    "https://mirrors.dotsrc.org/archlinux/\$repo/os/\$arch"
    "https://ftp.fau.de/archlinux/\$repo/os/\$arch"
    "https://mirror.netcologne.de/archlinux/\$repo/os/\$arch"
)
MIRRORLIST=/etc/pacman.d/mirrorlist
PACMAN_CONF=/etc/pacman.conf
MIRRORS_SWAPPED=0
use_fallback_mirrors() {
    [ "$MIRRORS_SWAPPED" = 1 ] && return 1
    [ -f "$MIRRORLIST" ] || return 1
    # Only plain Arch: derivatives (CachyOS, EndeavourOS) ship their own mirror setup.
    grep -q "^Include = /etc/pacman.d/mirrorlist" "$PACMAN_CONF" || return 1
    sudo cp -n "$MIRRORLIST" "$MIRRORLIST.rice-backup"
    { echo "# Fallback mirrors added by hypr-rice; the original is mirrorlist.rice-backup."
      printf 'Server = %s\n' "${FALLBACK_MIRRORS[@]}"
      cat "$MIRRORLIST.rice-backup"; } | sudo tee "$MIRRORLIST" >/dev/null
    MIRRORS_SWAPPED=1
    info "зеркала не отвечают, переключаюсь на запасные (старый список: mirrorlist.rice-backup)"
}

# pacman's messages for a download that failed on the way, as opposed to a refusal (missing
# package, conflict, broken database), where a retry or another mirror changes nothing. A 404
# is not among them: it means a stale package database, which `pacman -Syu` fixes, not a retry.
NETWORK_ERROR='Operation too slow|Could not resolve host|Connection timed out|Connection reset|Failed to connect|SSL connect error|transfer closed|Recv failure|failed to synchronize all databases'

pac() {  # pacman that retries downloads cut off by a flaky network
    # Stalled downloads ("Operation too slow") are common behind throttling; whatever was already
    # fetched stays in the cache, so every retry gets further. From the 2nd failure the fallback
    # mirrors go first, from the 3rd pacman stops giving up on slow transfers.
    local try extra=() errors status
    errors=$(mktemp)
    for try in 1 2 3 4 5 6; do
        # stderr goes to a file for the check below and is shown right after; stdout stays on the
        # terminal with its progress bars. (Copying it live through tee left nothing to wait on
        # safely: $! is the sudo keeper, which runs as long as rice does.)
        status=0
        sudo pacman --noconfirm "${extra[@]}" "$@" 2>"$errors" || status=$?
        cat "$errors" >&2
        if [ "$status" -eq 0 ]; then
            rm -f "$errors"
            return 0
        fi
        grep -qE "$NETWORK_ERROR" "$errors" || break
        [ "$try" -ge 2 ] && { use_fallback_mirrors || true; }
        [ "$try" -ge 3 ] && extra=(--disable-download-timeout)
        [ "$try" -lt 6 ] && info "загрузка прервалась, повтор $((try + 1))/6"
        sleep 3
    done
    rm -f "$errors"
    return 1
}

# ---------- packages: hypr-rice repo and AUR ----------

pkg_repo_enabled() { grep -q '^\[hypr-rice\]' "$PACMAN_CONF"; }

setup_pkg_repo() {
    # The prebuilt AUR packages (works where aur.archlinux.org is blocked).
    if ! curl -fsSIL --max-time 20 "$PKG_REPO_URL/hypr-rice.db" >/dev/null; then
        warn "репозиторий hypr-rice-pkgs недоступен, AUR-пакеты будут собираться на месте"
        return 0
    fi
    if ! sudo pacman-key --list-keys "$PKG_KEY_FPR" >/dev/null 2>&1; then
        sudo pacman-key --init >/dev/null 2>&1 || true
        sudo pacman-key --add "$SRC/system/hypr-rice-pkgs.asc" >/dev/null
        sudo pacman-key --lsign-key "$PKG_KEY_FPR" >/dev/null
    fi
    if ! pkg_repo_enabled; then
        printf '%s\n' "" "[hypr-rice]" "SigLevel = Required DatabaseOptional" "Server = $PKG_REPO_URL" \
            | sudo tee -a "$PACMAN_CONF" >/dev/null
        ok "подключён репозиторий hypr-rice (собранные AUR-пакеты)"
    fi
    # Without a fresh sync pacman does not know the repo's packages yet. The sync upgrades too: Arch
    # does not support installing from fresher databases than the system was upgraded from.
    pac -Syu || warn "не удалось обновить систему вместе с базой hypr-rice: rice upgrade"
}

aur_reachable() { curl -fsSI --max-time 10 https://aur.archlinux.org >/dev/null 2>&1; }

build_from_github_mirror() {  # PKGBUILD from github.com/archlinux/aur, built here
    local pkg=$1 dir log="$CACHE/build-$1.log" deps k
    mkdir -p "$CACHE"
    dir=$(mktemp -d)
    git clone -q --depth 1 --single-branch --branch "$pkg" https://github.com/archlinux/aur.git "$dir/$pkg" \
        >"$log" 2>&1 || { rm -rf "$dir"; return 1; }
    # makepkg's own dependency install has no retries, so flaky mirrors break it: do it here.
    deps=$(cd "$dir/$pkg" && makepkg --printsrcinfo 2>/dev/null \
        | sed -nE 's/^\s*(depends|makedepends) = ([^<>=]+).*/\2/p' | sort -u || true)
    local d need=()
    # Only what is missing and resolvable from the repos: one AUR name would fail the whole call.
    # shellcheck disable=SC2086
    for d in $(pacman -T $deps 2>/dev/null); do
        pacman -Sp --print-format %n "$d" >/dev/null 2>&1 && need+=("$d")
    done
    [ ${#need[@]} -eq 0 ] || pac -S --needed --asdeps "${need[@]}" >>"$log" 2>&1 || true
    # Upstream signing keys the PKGBUILD trusts (papirus-folders checks its git tag).
    for k in $(cd "$dir/$pkg" && makepkg --printsrcinfo 2>/dev/null | sed -nE 's/^\s*validpgpkeys = (.*)/\1/p'); do
        gpg --batch --keyserver hkps://keyserver.ubuntu.com --recv-keys "$k" >>"$log" 2>&1 \
            || gpg --batch --keyserver hkps://keys.openpgp.org --recv-keys "$k" >>"$log" 2>&1 || true
    done
    (cd "$dir/$pkg" && makepkg -si --noconfirm --needed) >>"$log" 2>&1 || { rm -rf "$dir"; return 1; }
    rm -rf "$dir"
}

ensure_yay() {
    command -v yay >/dev/null && return 0
    # From the hypr-rice repo when it has it.
    if pacman -Si yay-bin >/dev/null 2>&1; then pac -S --needed yay-bin >/dev/null 2>&1 && return 0; fi
    aur_reachable || return 1
    local dir
    dir=$(mktemp -d)
    git clone -q --depth 1 https://aur.archlinux.org/yay-bin.git "$dir/yay-bin" \
        && (cd "$dir/yay-bin" && makepkg -si --noconfirm)
    rm -rf "$dir"
    command -v yay >/dev/null
}

aur_install() {  # AUR packages: hypr-rice repo first, then yay, then the GitHub mirror of the AUR
    local pkg failed=() rest=()
    [ $# -gt 0 ] || return 0
    for pkg in "$@"; do
        pacman -Qq "$pkg" >/dev/null 2>&1 && continue
        if pkg_repo_enabled && pacman -Si "hypr-rice/$pkg" >/dev/null 2>&1; then
            pac -S --needed "hypr-rice/$pkg" >/dev/null && continue
        fi
        rest+=("$pkg")
    done
    [ ${#rest[@]} -gt 0 ] || return 0
    if aur_reachable && ensure_yay; then
        yay -S --needed --noconfirm --answerdiff None --answerclean None --removemake "${rest[@]}" >/dev/null 2>&1 \
            && return 0
    fi
    for pkg in "${rest[@]}"; do
        pacman -Qq "$pkg" >/dev/null 2>&1 && continue
        info "собираю $pkg (PKGBUILD с зеркала AUR на GitHub)"
        build_from_github_mirror "$pkg" >/dev/null 2>&1 || failed+=("$pkg")
    done
    [ ${#failed[@]} -eq 0 ] || { warn "не удалось поставить из AUR: ${failed[*]} (логи: ~/.cache/hypr-rice/build-*.log)"; return 1; }
}

# ---------- program catalog (packages/apps.txt) ----------

APP_IDS=()
declare -gA APP_GROUP APP_NAME APP_SRC  # -g: global even when tests source this file from a function
load_apps() {
    local id group name src
    APP_IDS=()
    while IFS='|' read -r id group name src; do
        id=$(trim "$id")
        APP_IDS+=("$id")
        APP_GROUP[$id]=$(trim "$group")
        APP_NAME[$id]=$(trim "$name")
        APP_SRC[$id]=$(trim "$src")
    done < <(list "$SRC/packages/apps.txt")
}

# Installed packages and Flatpak apps, read once and kept until something is installed or removed:
# asking pacman package by package took seconds for the whole catalog.
declare -gA INSTALLED=()
INSTALLED_READ=0
is_installed() {  # is_installed PACKAGE, or flatpak:ID
    if [ "$INSTALLED_READ" = 0 ]; then
        INSTALLED=()
        local name
        while read -r name; do INSTALLED[$name]=1; done < <(pacman -Qq 2>/dev/null)
        while read -r name; do INSTALLED[flatpak:$name]=1; done < <(flatpak list --app --columns=application 2>/dev/null)
        INSTALLED_READ=1
    fi
    [ -n "${INSTALLED[$1]:-}" ]
}
forget_installed() { INSTALLED_READ=0; }

# Every package of app ID is installed (pacman, AUR, Flatpak, AppImage); its files are not checked.
app_packages_installed() {
    local tok
    for tok in ${APP_SRC[$1]}; do
        case "$tok" in
            file:*|release:*|hook:*|browser) ;;
            appimage:*) [ -x "$HOME/Applications/$1.AppImage" ] || return 1 ;;
            flatpak:*) is_installed "$tok" || return 1 ;;
            path:*) [ -e "${tok#path:}" ] || return 1 ;;
            dep:*) is_installed "${tok#dep:}" || return 1 ;;
            *) is_installed "${tok#aur:}" || return 1 ;;
        esac
    done
}

# App ID is fully present: its packages and the files the rice copies for it.
app_installed() {
    app_packages_installed "$1" || return 1
    local tok
    for tok in ${APP_SRC[$1]}; do
        [[ $tok == file:* || $tok == release:* ]] || continue
        [ -e "$HOME/${tok#*:}" ] || return 1
    done
}

PICKED=()
picked() { local id; for id in "${PICKED[@]}"; do [ "$id" = "$1" ] && return 0; done; return 1; }

# The catalog lines pick_apps offers ("group · name=id"): to install, what is not installed yet; to
# remove, what is.
catalog_choices() {
    local mode=$1 id
    for id in "${APP_IDS[@]}"; do
        if app_installed "$id"; then
            [ "$mode" = remove ] || continue
        elif [ "$mode" = remove ]; then
            continue
        fi
        echo "${APP_GROUP[$id]} · ${APP_NAME[$id]}=$id"
    done
}

# pick_apps MODE: "install" (only what is not installed yet is offered)
#                 "remove"  (only installed programs are offered)
pick_apps() {
    local mode=${1:-install} id opts=()
    PICKED=()
    if [ "$mode" = install ] && [ -n "${RICE_APPS:-}" ]; then
        case "$RICE_APPS" in
            all) PICKED=("${APP_IDS[@]}") ;;
            none) ;;
            *) IFS=', ' read -r -a PICKED <<<"$RICE_APPS" ;;  # "steam,lutris" and "steam, lutris" alike
        esac
        info "программы (RICE_APPS): ${PICKED[*]:-нет}"
    else
        have_tty || { info "нет терминала, программы не выбираю"; return; }
        mapfile -t opts < <(catalog_choices "$mode")
        if [ ${#opts[@]} -eq 0 ]; then
            if [ "$mode" = remove ]; then info "из каталога ничего не установлено"; else info "всё из каталога уже установлено"; fi
            return
        fi
        local header="Какие программы поставить?"
        [ "$mode" = remove ] && header="Какие программы удалить?"
        mapfile -t PICKED < <(choose_many "$header" "" "${opts[@]}" || true)
    fi
    local clean=()
    for id in "${PICKED[@]}"; do
        [ -n "$id" ] || continue
        if [ -n "${APP_NAME[$id]:-}" ]; then
            clean+=("$id")
        else
            warn "нет такой программы в каталоге: $id (список — packages/apps.txt)"
        fi
    done
    PICKED=("${clean[@]}")
    if [ ${#PICKED[@]} -gt 0 ]; then
        ok "выбрано: $(for id in "${PICKED[@]}"; do printf '%s, ' "${APP_NAME[$id]}"; done | sed 's/, $//')"
    else
        ok "ничего не выбрано"
    fi
}

# Vulkan for 32-bit games: Steam's lib32-vulkan-driver has several providers and
# --noconfirm would just take the first one, which is wrong for most GPUs.
gpu_vulkan() {
    local v
    for v in /sys/class/drm/card*/device/vendor; do
        case "$(cat "$v" 2>/dev/null)" in
            0x1002) echo "vulkan-radeon lib32-vulkan-radeon" ;;
            0x8086) echo "vulkan-intel lib32-vulkan-intel" ;;
            0x10de) echo "nvidia-utils lib32-nvidia-utils" ;;
            0x1af4) echo "vulkan-virtio lib32-vulkan-virtio" ;;
        esac
    done | tr ' ' '\n' | sort -u
}

enable_multilib() {
    grep -q '^\[multilib\]' "$PACMAN_CONF" && return 0
    sudo sed -i '/^#\[multilib\]/{N;s/#\[multilib\]\n#Include/[multilib]\nInclude/}' "$PACMAN_CONF"
    grep -q '^\[multilib\]' "$PACMAN_CONF" || printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' \
        | sudo tee -a "$PACMAN_CONF" >/dev/null
    # With the upgrade, as in setup_pkg_repo: a sync alone would leave a partial upgrade.
    pac -Syu || return 1
    ok "включён репозиторий multilib"
}

# Post-install steps some programs need ("hook:<name>" in apps.txt).
EXE_TYPES=(application/x-ms-dos-executable application/x-msdownload application/vnd.microsoft.portable-executable
           application/x-msi application/x-ms-shortcut application/x-bat)

# Thunar runs a .exe that has the execute bit (most archives unpack them so) as a program of its own
# instead of opening it with umu-run.desktop, and the kernel cannot run it ("Exec format error"). This
# rule makes the kernel hand every Windows program ("MZ" are its first two bytes) to proton-run, so
# such a .exe and ./game.exe in a terminal start through Proton too.
PROTON_BINFMT=/etc/binfmt.d/proton-run.conf
PROTON_BINFMT_RULE=/proc/sys/fs/binfmt_misc/proton-run

hook_proton_exe() {
    # Opening a .exe runs it through Proton (umu, via ~/.local/bin/proton-run) instead of plain wine.
    local d="$HOME/.local/share/applications" m
    mkdir -p "$d"
    printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=Proton (umu)" \
        "Comment=Запустить Windows-программу через Proton" "Exec=$HOME/.local/bin/proton-run %f" "Icon=wine" \
        "Terminal=false" "NoDisplay=true" "MimeType=$(IFS=';'; echo "${EXE_TYPES[*]}");" > "$d/umu-run.desktop"
    for m in "${EXE_TYPES[@]}"; do
        xdg-mime default umu-run.desktop "$m" 2>/dev/null || true
    done
    update-desktop-database "$d" 2>/dev/null || true
    printf ':proton-run:M::MZ::%s:\n' "$HOME/.local/bin/proton-run" | sudo tee "$PROTON_BINFMT" >/dev/null || return 1
    sudo systemctl restart systemd-binfmt.service
}

unhook_proton_exe() {
    # Without this, .exe files would stay bound to a launcher whose umu-run is gone.
    local d="$HOME/.local/share/applications" list="$HOME/.config/mimeapps.list"
    rm -f "$d/umu-run.desktop"
    if [ -f "$list" ]; then
        sed -i -e 's/umu-run\.desktop;\?//g' -e '/=$/d' "$list"
    fi
    update-desktop-database "$d" 2>/dev/null || true
    sudo rm -f "$PROTON_BINFMT"
    if [ -e "$PROTON_BINFMT_RULE" ]; then
        echo -1 | sudo tee "$PROTON_BINFMT_RULE" >/dev/null
    fi
}

# ---- memory: zram and earlyoom, set up the same on any machine (sizes are shares of its RAM) ----
# Files the rice wrote start with RICE_MARK; one without it is the user's own and stays as it is.
RICE_MARK="# hypr-rice"
ZRAM_CONF=/etc/systemd/zram-generator.conf
ZRAM_SYSCTL=/etc/sysctl.d/99-hypr-rice-zram.conf
EARLYOOM_CONF=/etc/default/earlyoom

rice_owns() {  # rice_owns FILE: absent, or written by the rice
    [ ! -e "$1" ] || head -n1 "$1" | grep -q "^$RICE_MARK"
}

hook_zram() {
    if ! rice_owns "$ZRAM_CONF"; then
        info "zram: свой $ZRAM_CONF оставлен как есть"
        return 0
    fi
    # zram-generator works the size out on each machine: half of its RAM, at most 8 GiB.
    printf '%s\n' "$RICE_MARK (rice → программы → zram). Half of the RAM, at most 8 GiB, zstd-compressed." \
        "[zram0]" "zram-size = min(ram / 2, 8192)" "compression-algorithm = zstd" "swap-priority = 100" \
        | sudo tee "$ZRAM_CONF" >/dev/null || return 1
    # The usual tuning for swap on zram (ArchWiki): swap early and in single pages, it is in RAM anyway.
    printf '%s\n' "$RICE_MARK (rice → программы → zram)." "vm.swappiness = 180" "vm.watermark_boost_factor = 0" \
        "vm.watermark_scale_factor = 125" "vm.page-cluster = 0" | sudo tee "$ZRAM_SYSCTL" >/dev/null || return 1
    sudo sysctl -q --system || return 1
    sudo systemctl daemon-reload || return 1
    # A zram swap already in use is not rebuilt now: taking it off needs that much free RAM.
    if swapon --show=NAME --noheadings | grep -q zram0; then
        ok "zram настроен: новый размер — после перезагрузки"
    else
        sudo systemctl start systemd-zram-setup@zram0.service && ok "zram включён: половина памяти, не больше 8 ГиБ"
    fi
}

unhook_zram() {
    if rice_owns "$ZRAM_CONF"; then sudo rm -f "$ZRAM_CONF"; fi
    if rice_owns "$ZRAM_SYSCTL"; then sudo rm -f "$ZRAM_SYSCTL"; fi
    info "zram выключится после перезагрузки"
}

hook_earlyoom() {
    # The package's own file is replaced; one the user changed (pacman: [modified]) and not ours stays.
    if ! rice_owns "$EARLYOOM_CONF" && pacman -Qii earlyoom 2>/dev/null | grep -q "$EARLYOOM_CONF \[modified\]"; then
        info "earlyoom: свой $EARLYOOM_CONF оставлен как есть"
    else
        # Thresholds are earlyoom's own shares (10% of RAM and of swap). What it should spare (the
        # desktop, Steam, games, Windows ones through Proton too) and what to close first (browser tabs).
        # systemd splits $EARLYOOM_ARGS at spaces: no space inside a pattern ("Web.Content", not "Web Content").
        printf '%s\n' "$RICE_MARK (rice → программы → earlyoom)." \
            "EARLYOOM_ARGS=\"-r 3600 -n --avoid '(^|/)(init|systemd.*|Xwayland|Hyprland|sshd|pipewire.*|wireplumber|waybar|quickshell|qs|steam|steamwebhelper|gamescope|.*\\.exe|RimWorld.*)\$' --prefer '(^|/)(chrome|chromium|firefox|zen|Web.Content|Isolated.Web.Co)\$'\"" \
            | sudo tee "$EARLYOOM_CONF" >/dev/null || return 1
    fi
    sudo systemctl enable earlyoom.service >/dev/null 2>&1 || return 1
    sudo systemctl restart earlyoom.service && ok "earlyoom: при нехватке памяти первыми закрывает вкладки браузера"
}

unhook_earlyoom() {
    sudo systemctl disable --now earlyoom.service >/dev/null 2>&1 || true
}

# ---- Igareck AntiDPI: anti-DPI strategies on zapret2, made for Debian/Ubuntu ----
# Its own installer runs without questions (answers as flags, no terminal on stdin): it then needs
# no apt, only the Arch packages apps.txt installs before this step. Its installer runs as root, so
# the version is pinned here, with the archive's SHA-256: a checksum list from the same release would
# vouch for nothing if the release itself were replaced. A new version comes with a rice update
# (which reruns this step); the same version is not installed again.
ANTIDPI_REPO=https://github.com/igareck/anti-dpi-for-russia
ANTIDPI_VERSION=1.1
ANTIDPI_SHA256=bd581b6ca6c43b86dee4dcdd8d912519e04e6ffe077f3abecfa137649ebdae48
ANTIDPI_PREFIX=/opt/igareck-antidpi
ANTIDPI_DESKTOP="$HOME/.local/share/applications/hypr-rice-antidpi.desktop"

antidpi_installed() {  # the version in its installation.json, or nothing
    sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ANTIDPI_PREFIX/installation.json" 2>/dev/null | head -n1
}

hook_antidpi() {
    local version=$ANTIDPI_VERSION installed work name
    installed=$(antidpi_installed)
    if [ "$installed" = "$version" ]; then
        ok "Igareck AntiDPI $version уже стоит"
        return 0
    fi
    work=$(mktemp -d)
    name="Igareck_AntiDPI_CLI_v${version}_Linux_x64.tar.gz"
    if ! curl -fsSL -o "$work/$name" "$ANTIDPI_REPO/releases/download/v$version/$name"; then
        warn "AntiDPI $version не скачался"
        rm -rf "$work"
        return 1
    fi
    if [ "$(file_sha256 "$work/$name")" != "$ANTIDPI_SHA256" ]; then
        warn "AntiDPI $version: архив не совпал с контрольной суммой райса, не ставлю"
        rm -rf "$work"
        return 1
    fi
    if ! tar -xzf "$work/$name" -C "$work"; then
        warn "AntiDPI $version: архив не распаковался"
        rm -rf "$work"
        return 1
    fi
    # A new version replaces the old one whole: its installer takes only an empty folder.
    if [ -n "$installed" ] && ! sudo python3 "$ANTIDPI_PREFIX/remove_installation.py" --purge --yes </dev/null >/dev/null; then
        warn "AntiDPI $installed не удалился, $version не ставлю"
        rm -rf "$work"
        return 1
    fi
    if ! sudo python3 "$work/${name%.tar.gz}/app/install.py" install --prefix "$ANTIDPI_PREFIX" --engine compatible \
            --shortcuts no --global-command yes --skip-deps --no-launch </dev/null; then
        warn "AntiDPI $version не установился (лог — в выводе выше и в /var/log/igareck-zapret2)"
        rm -rf "$work"
        return 1
    fi
    rm -rf "$work"
    mkdir -p "$(dirname "$ANTIDPI_DESKTOP")"
    printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=Igareck AntiDPI" \
        "Comment=Обход DPI: стратегии на zapret2" "Exec=kitty -e igareck-antidpi" "Icon=network-vpn" \
        "Terminal=false" "Categories=Network;" > "$ANTIDPI_DESKTOP"
    ok "Igareck AntiDPI $version: запуск — igareck-antidpi или лаунчер (Alt+R)"
    # Two zapret engines on the same traffic get in each other's way.
    if systemctl is-active --quiet zapret2.service 2>/dev/null; then
        warn "работает служба zapret2: перед стратегиями AntiDPI останови её — sudo systemctl disable --now zapret2"
    fi
}

unhook_antidpi() {
    if [ -f "$ANTIDPI_PREFIX/remove_installation.py" ]; then
        sudo python3 "$ANTIDPI_PREFIX/remove_installation.py" --purge --yes </dev/null >/dev/null
    fi
    rm -f "$ANTIDPI_DESKTOP"
}

# Called as `hook || warn`, a hook runs with set -e ignored (bash's rule for anything left of ||):
# each of its steps that may fail ends it with `|| return 1` explicitly, or a failure midway
# would go unnoticed and the steps after it would run anyway. The same holds for tuning_*_on/off.
run_hook() { "hook_${1//-/_}" || warn "не отработал шаг $1"; }
run_unhook() {  # the undo of a setup step, for the steps that have one
    local undo="unhook_${1//-/_}"
    if declare -F "$undo" >/dev/null; then "$undo"; fi
}

# An update may change what a program's setup step does, so it runs again for what is installed.
rerun_installed_hooks() {
    local id tok
    for id in "${APP_IDS[@]}"; do
        app_installed "$id" || continue
        for tok in ${APP_SRC[$id]}; do
            if [[ $tok == hook:* ]]; then
                run_hook "${tok#hook:}"
            fi
        done
    done
}

app_desktop_file() {  # first .desktop file an installed app ships
    local tok f
    for tok in ${APP_SRC[$1]}; do
        case "$tok" in
            flatpak:*) f="${tok#flatpak:}.desktop"; [ -e "/var/lib/flatpak/exports/share/applications/$f" ] \
                           || [ -e "$HOME/.local/share/flatpak/exports/share/applications/$f" ] && { echo "$f"; return; } ;;
            hook:*|browser|file:*|release:*|appimage:*|path:*|dep:*) ;;
            *) f=$(pacman -Qlq "${tok#aur:}" 2>/dev/null | grep -m1 '/usr/share/applications/.*\.desktop$') \
                   && { basename "$f"; return; } ;;
        esac
    done
}

install_apps() {  # installs PICKED
    local id tok own repo_pk=() helper_pk=() aur_pk=() flat=() appimages=() hooks=() browsers=()
    [ ${#PICKED[@]} -gt 0 ] || return 0
    for id in "${PICKED[@]}"; do
        own=0  # the first package of a program is the program; the ones after it are its helpers
        for tok in ${APP_SRC[$id]}; do
            case "$tok" in
                aur:*) aur_pk+=("${tok#aur:}"); own=1 ;;
                appimage:*) appimages+=("$id ${tok#appimage:}") ;;
                flatpak:*) flat+=("${tok#flatpak:}") ;;
                hook:*) hooks+=("${tok#hook:}") ;;
                dep:*) repo_pk+=("${tok#dep:}") ;;
                path:*) ;;
                browser) browsers+=("$id") ;;
                file:*)  # a rice file that only ships with this program (put back if it was dropped)
                    [ -e "$HOME/${tok#file:}" ] || install -Dm755 "$SRC/home/${tok#file:}" "$HOME/${tok#file:}" ;;
                release:*) install_release_file "${tok#release:}" || true ;;
                *) if [ "$own" = 0 ]; then repo_pk+=("$tok"); own=1; else helper_pk+=("$tok"); fi ;;
            esac
        done
    done
    if picked steam; then mapfile -t -O "${#repo_pk[@]}" repo_pk < <(gpu_vulkan); fi
    [ ${#flat[@]} -eq 0 ] || repo_pk+=(flatpak)
    [ ${#appimages[@]} -eq 0 ] || repo_pk+=(fuse2)
    if printf '%s\n' "${repo_pk[@]}" "${helper_pk[@]}" | grep -qE '^(steam|umu-launcher|lib32-.*)$'; then enable_multilib; fi

    [ ${#repo_pk[@]} -eq 0 ] || pac -S --needed "${repo_pk[@]}" || warn "часть программ из репозиториев не встала"
    # Helpers come in as dependencies, so they go with the program; one the user installed on their
    # own is skipped by --needed and stays theirs.
    [ ${#helper_pk[@]} -eq 0 ] || pac -S --needed --asdeps "${helper_pk[@]}" || warn "часть дополнительных пакетов не встала"
    [ ${#aur_pk[@]} -eq 0 ] || aur_install "${aur_pk[@]}" || true
    if [ ${#flat[@]} -gt 0 ]; then
        flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
            && flatpak install --user -y --noninteractive flathub "${flat[@]}" >/dev/null \
            || warn "flatpak: не встало ${flat[*]}"
    fi
    local entry url want dest
    for entry in "${appimages[@]}"; do
        # "appimage:URL#sha256=HEX": a pinned version, run only when it is the file the signed repo names.
        id=${entry%% *}
        url=${entry#* }
        want=${url##*#sha256=}
        url=${url%%#*}
        if [ "$want" = "$url" ]; then
            warn "${APP_NAME[$id]}: в packages/apps.txt нет контрольной суммы (#sha256=), не ставлю"
            continue
        fi
        dest="$HOME/Applications/$id.AppImage"
        mkdir -p "$HOME/Applications" "$HOME/.local/share/applications"
        if curl -fL --progress-bar -o "$dest.part" "$url" && [ "$(file_sha256 "$dest.part")" = "$want" ]; then
            mv "$dest.part" "$dest"
            chmod +x "$dest"
            # So the launcher (Alt+R) lists it like any installed app.
            printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=${APP_NAME[$id]}" "Exec=$dest" \
                "Icon=applications-games" "Categories=Game;" \
                > "$HOME/.local/share/applications/hypr-rice-$id.desktop"
            ok "${APP_NAME[$id]} → ~/Applications/$id.AppImage"
        else
            rm -f "$dest.part"
            warn "${APP_NAME[$id]} не скачался или не совпал с контрольной суммой"
        fi
    done
    local h
    for h in "${hooks[@]}"; do run_hook "$h"; done
    # The first browser picked becomes the default when none is set (Alt+B opens it).
    if [ ${#browsers[@]} -gt 0 ] && [ -z "$(xdg-settings get default-web-browser 2>/dev/null)" ]; then
        local f
        f=$(app_desktop_file "${browsers[0]}" || true)
        [ -n "$f" ] && xdg-settings set default-web-browser "$f" 2>/dev/null && ok "браузер по умолчанию: ${APP_NAME[${browsers[0]}]}"
    fi
    forget_installed
    ok "программ: ${#PICKED[@]}"
}

# Prebuilt files of the rice too big for git (neoHtop with the rice's themes built in) are assets of
# the GitHub release "files", named <file>-<first 12 characters of its sha256>; sync.sh uploads them.
# Their checksums are in packages/release.sha256 in the signed repo, so a file changed on GitHub
# is refused.
RELEASE_URL="https://github.com/larion928/hypr-rice/releases/download/files"

release_sha256() {  # release_sha256 PATH: the checksum the repo expects for ~/PATH
    awk -v path="$1" '$2 == path {print $1}' "$SRC/packages/release.sha256"
}

file_sha256() { sha256sum < "$1" | cut -d' ' -f1; }

install_release_file() {  # install_release_file PATH: puts the expected file at ~/PATH
    local path=$1 want dest part
    want=$(release_sha256 "$path")
    [ -n "$want" ] || { warn "$path: нет контрольной суммы в packages/release.sha256"; return 1; }
    dest="$HOME/$path"
    if [ -f "$dest" ] && [ "$(file_sha256 "$dest")" = "$want" ]; then
        return 0
    fi
    part="$dest.part"
    mkdir -p "$(dirname "$dest")"
    if ! curl -fL --progress-bar -o "$part" "$RELEASE_URL/$(basename "$path")-${want:0:12}"; then
        rm -f "$part"
        warn "$(basename "$path") не скачался"
        return 1
    fi
    if [ "$(file_sha256 "$part")" != "$want" ]; then
        rm -f "$part"
        warn "$(basename "$path"): скачанный файл не совпал с контрольной суммой и не установлен"
        return 1
    fi
    chmod 755 "$part"
    mv "$part" "$dest"
}

# After an update, installed programs get their prebuilt files of the new version.
update_release_files() {
    local id tok
    for id in "${APP_IDS[@]}"; do
        for tok in ${APP_SRC[$id]}; do
            [[ $tok == release:* ]] || continue
            [ -e "$HOME/${tok#release:}" ] || continue
            install_release_file "${tok#release:}" || true
        done
    done
}

remove_apps() {  # removes PICKED (packages, flatpaks, AppImages)
    local id tok own name pk=() helpers=() flat=()
    for id in "${PICKED[@]}"; do
        own=0
        for tok in ${APP_SRC[$id]}; do
            case "$tok" in
                appimage:*) rm -f "$HOME/Applications/$id.AppImage" "$HOME/.local/share/applications/hypr-rice-$id.desktop" ;;
                flatpak:*) flat+=("${tok#flatpak:}") ;;
                file:*|release:*) rm -f "$HOME/${tok#*:}" ;;
                hook:*) run_unhook "${tok#hook:}" ;;
                browser|dep:*|path:*) ;;
                *)
                    name=${tok#aur:}
                    if [ "$own" = 1 ]; then helpers+=("$name")
                    elif pacman -Qq "$name" >/dev/null 2>&1; then pk+=("$name")
                    fi
                    own=1 ;;
            esac
        done
    done
    # The program's own package, with its dependencies nothing else needs.
    [ ${#pk[@]} -eq 0 ] || sudo pacman -Rs --noconfirm "${pk[@]}" || warn "часть пакетов не удалилась (их требуют другие)"
    # Its helpers only once they are orphans: installed as dependencies and needed by nothing now.
    # One the user installed on purpose is explicit, never an orphan, and stays.
    local orphans=()
    mapfile -t orphans < <(printf '%s\n' "${helpers[@]}" | grep -xF -f <(pacman -Qdtq 2>/dev/null) || true)
    [ ${#orphans[@]} -eq 0 ] || sudo pacman -Rs --noconfirm "${orphans[@]}" || warn "часть дополнительных пакетов не удалилась"
    [ ${#flat[@]} -eq 0 ] || flatpak uninstall --user -y --noninteractive "${flat[@]}" >/dev/null || true
    forget_installed
    ok "удалено: ${#PICKED[@]}"
}

# ---------- SDDM: make sure it is the one that starts, with our theme and Hyprland ----------

SDDM_CONF=/etc/sddm.conf
SDDM_CONF_D=/etc/sddm.conf.d

setup_sddm() {
    local cur
    if [ "${MODE:-replace}" = coexist ] && [ "${USE_SDDM:-1}" = 0 ]; then
        info "экран входа оставлен свой; Hyprland появится в его списке сеансов"
        return 0
    fi
    # Whatever display manager owns display-manager.service now, not just a known list.
    cur=$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || true)
    if [ -n "$cur" ] && [ "$(basename "$cur")" != sddm.service ]; then
        sudo systemctl disable "$(basename "$cur")" >/dev/null 2>&1 || true
        info "выключен экран входа $(basename "$cur" .service)"
    fi
    sudo systemctl enable --force sddm.service >/dev/null 2>&1 || warn "не включился sddm"

    sudo rm -f "$SDDM_CONF_D/10-theme.conf"
    sudo install -Dm644 "$SRC/system/sddm-theme.conf" "$SDDM_CONF_D/99-hypr-rice.conf"
    # /etc/sddm.conf is read after sddm.conf.d and would override our theme.
    if [ -f "$SDDM_CONF" ] && grep -qE '^\s*Current\s*=' "$SDDM_CONF"; then
        sudo cp -n "$SDDM_CONF" "$SDDM_CONF.rice-backup"
        sudo sed -i -E 's/^(\s*Current\s*=)/# hypr-rice: \1/' "$SDDM_CONF"
        info "тема из $SDDM_CONF отключена (копия: sddm.conf.rice-backup)"
    fi
    # Autologin straight into another desktop would skip the login screen entirely.
    local f s
    for f in "$SDDM_CONF" "$SDDM_CONF_D"/*.conf; do
        [ -f "$f" ] || continue
        s=$(sed -n -E 's/^\s*Session\s*=\s*(.*)$/\1/p' "$f" | head -n1)
        [ -n "$s" ] || continue
        case "$s" in hyprland*) continue ;; esac
        if ask "Настроен автовход в «${s%.desktop}» ($f). Переключить автовход на Hyprland?" y; then
            sudo cp -n "$f" "$f.rice-backup"
            sudo sed -i -E 's/^(\s*Session\s*=\s*).*/\1hyprland.desktop/' "$f"
        fi
    done
    # Preselect Hyprland on the login screen (SDDM remembers the last session per machine);
    # side by side with another desktop the last choice is left alone.
    if [ "${MODE:-replace}" = coexist ]; then
        ok "SDDM: тема sugar-candy, сеанс выбирается на экране входа"
        return 0
    fi
    local state=/var/lib/sddm/state.conf
    sudo mkdir -p /var/lib/sddm
    printf '%s\n' "[Last]" "Session=/usr/share/wayland-sessions/hyprland.desktop" "User=$USER" \
        | sudo tee "$state" >/dev/null
    sudo chown sddm:sddm "$state" 2>/dev/null || true
    ok "SDDM: тема sugar-candy, по умолчанию Hyprland"
}

# ---------- rice files ----------

RICE_DIRS=(hypr waybar quickshell kitty rofi wofi dunst mako swaync eww ags hyprpanel wlogout
           fuzzel walker histui swaylock alacritty foot)

# Files that are merged into the user's own instead of replacing them.
MERGED_JSON=(".config/Code - OSS/User/settings.json")
# The user's own version of each merged file from before the rice's first merge (or a PATH.absent mark
# when there was none): uninstall puts it back.
ORIGINALS="$HOME/.config/hypr-rice/originals"
# Every file copy_rice_files put in ~: an update removes those the new version no longer ships, and
# uninstall removes what it lists. Nothing else in ~ is ever removed this way.
MANIFEST="$HOME/.config/hypr-rice/installed-files"

is_merged() { printf '%s\n' "${MERGED_JSON[@]}" | grep -qxF "$1"; }

# Code - OSS writes settings.json as JSONC (comments, trailing commas), which jq refuses. Prints
# USER's settings with OURS on top, nested objects merged; fails, printing nothing, if USER does not
# parse. The comments do not survive: the file before is kept as PATH.rice-backup (put_merged_file).
merge_jsonc() {  # merge_jsonc USER OURS
    python3 - "$1" "$2" <<'PY'
import json, re, sys

STRING = r'"(?:\\.|[^"\\])*"'
COMMENT = re.compile(STRING + r'|//[^\n]*|/\*.*?\*/', re.S)
TRAILING_COMMA = re.compile(STRING + r'|,(?=\s*[}\]])')

def strip(text):
    keep_strings = lambda match: match.group(0) if match.group(0).startswith('"') else ""
    return TRAILING_COMMA.sub(keep_strings, COMMENT.sub(keep_strings, text))

def merge(base, top):
    for key, value in top.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merge(base[key], value)
        else:
            base[key] = value
    return base

with open(sys.argv[1], encoding="utf-8") as user_file, open(sys.argv[2], encoding="utf-8") as ours_file:
    user = json.loads(strip(user_file.read()) or "{}")
    ours = json.loads(ours_file.read())
if not isinstance(user, dict):
    sys.exit(1)
print(json.dumps(merge(user, ours), indent=2, ensure_ascii=False))
PY
}

merge_user_file() {  # merge_user_file PATH: the merged ~/PATH ready as ~/PATH.rice-tmp (cwd: home/ of the rice)
    local path=$1 user="$HOME/$1"
    if [ ! -e "$ORIGINALS/$path" ] && [ ! -e "$ORIGINALS/$path.absent" ]; then
        mkdir -p "$(dirname "$ORIGINALS/$path")"
        if [ -f "$user" ]; then cp -a "$user" "$ORIGINALS/$path"; else : > "$ORIGINALS/$path.absent"; fi
    fi
    [ -f "$user" ] || return 0
    if ! merge_jsonc "$user" "./$path" > "$user.rice-tmp" 2>/dev/null; then
        rm -f "$user.rice-tmp"
        warn "$path не разобран: оставлен как есть, настройки райса в него не добавлены"
    fi
}

put_merged_file() {  # put_merged_file PATH: ~/PATH.rice-tmp in place of ~/PATH, the old one kept when they differ
    local user="$HOME/$1"
    [ -f "$user.rice-tmp" ] || return 0
    if cmp -s "$user.rice-tmp" "$user"; then
        rm -f "$user.rice-tmp"
        return 0
    fi
    cp -a "$user" "$user.rice-backup"
    mv "$user.rice-tmp" "$user"
}

remove_stale_files() {  # what the previous version put in ~ and this one no longer ships (cwd: home/ of the rice)
    local path
    [ -f "$MANIFEST" ] || return 0
    while IFS= read -r path; do
        if [ ! -e "./$path" ] && [ ! -L "./$path" ]; then
            rm -f "$HOME/$path"
        fi
    done < "$MANIFEST"
}

write_manifest() {  # write_manifest FILE...: the files of home/ that were copied to ~
    local f
    mkdir -p "$(dirname "$MANIFEST")"
    for f in "$@"; do
        f=${f#./}
        keep_theirs "$f" || is_merged "$f" || printf '%s\n' "$f"
    done > "$MANIFEST"
}

# __HOME__ in a file of the rice becomes the home folder; escaped for sed, it may hold | & or \.
fill_home() {  # fill_home [SED OPTION...] FILE
    local home
    home=$(printf '%s' "$HOME" | sed 's/[\\|&]/\\&/g')
    sed -e "s|__HOME__|$home|g" "$@"
}

keep_theirs() {  # coexist mode: a path of ours that would overwrite the other desktop's config
    [ "${MODE:-replace}" = coexist ] || return 1
    case "$1" in
        .config/fish/*) [ "${HAD_FISH:-0}" = 1 ] ;;
        .config/Code\ -\ OSS/User/keybindings.json) [ -e "$HOME/$1" ] ;;
        *) return 1 ;;
    esac
}

copy_rice_files() {  # copies home/ to ~, backing up what is replaced; MODE, DO_BACKUP, found[] from install
    local f j p
    cd "$SRC/home"
    mapfile -d '' FILES < <(find . -type f -print0 -o -type l -print0)
    HAD_FISH=0; [ -e "$HOME/.config/fish/config.fish" ] && HAD_FISH=1
    if [ "${DO_BACKUP:-0}" = 1 ]; then
        mkdir -p "$BACKUP"
        # Replace mode: foreign rice configs leave entirely. Coexist mode: only a foreign Hyprland
        # config does (two rices cannot share one Hyprland), everything else stays put.
        for p in "${found[@]}"; do
            case "$p" in
                "$HOME/.config/hypr") ;;  # handled below, the machine and user files stay
                *) [ "${MODE:-replace}" = replace ] && mv "$p" "$BACKUP/" ;;
            esac
        done
        if [ -d "$HOME/.config/hypr" ]; then
            mkdir -p "$BACKUP/hypr"
            find "$HOME/.config/hypr" -mindepth 1 -maxdepth 1 \
                ! -name monitors.lua ! -name devices.lua ! -name binds-user.lua ! -name user.lua -exec mv -t "$BACKUP/hypr/" {} +
        fi
        for f in "${FILES[@]}"; do
            f=${f#./}
            [ -e "$HOME/$f" ] || continue
            keep_theirs "$f" && continue
            mkdir -p "$BACKUP/home/$(dirname "$f")"
            cp -a "$HOME/$f" "$BACKUP/home/$f"
            is_merged "$f" || rm -f "$HOME/$f"
        done
        ok "старое → $BACKUP"
    fi
    # Merged files: ours on top of the user's own (Code-OSS keeps its other settings); a user's file
    # is never copied over, even when it cannot be merged.
    local excl=()
    for j in "${MERGED_JSON[@]}"; do
        merge_user_file "$j"
        [ -f "$HOME/$j" ] && excl+=(--exclude="./$j")
    done
    for f in "${FILES[@]}"; do
        f=${f#./}
        keep_theirs "$f" && excl+=(--exclude="./$f")
    done
    # Themes the user removed (Alt+F2 → Тема) stay removed until they bring them back there.
    local theme
    while IFS= read -r theme; do
        if [ -n "$theme" ]; then
            excl+=(--exclude="./.config/hypr/themes/$theme")
        fi
    done < <(cat "$HOME/.config/hypr-rice/removed-themes" 2>/dev/null)
    tar -cf - "${excl[@]}" . | tar -C "$HOME" -xf -
    for j in "${MERGED_JSON[@]}"; do put_merged_file "$j"; done
    remove_stale_files
    write_manifest "${FILES[@]}"
    [ "${MODE:-replace}" = coexist ] && [ "$HAD_FISH" = 1 ] && info "fish: оставлен твой конфиг"
    for f in "${FILES[@]}"; do
        f="$HOME/${f#./}"
        [ -f "$f" ] && grep -Iq "__HOME__" "$f" 2>/dev/null && fill_home -i "$f"
    done
    chmod +x "$HOME"/.local/bin/* "$HOME"/.config/hypr-rice/waybar/scripts/* "$HOME"/.config/hypr/scripts/*.py \
             "$HOME"/.config/hypr/scripts/ru-date "$HOME"/.claude/statusline.sh 2>/dev/null || true
    cd "$HOME"
    # Files that belong to programs that are not installed (neoHtop, ...).
    load_apps
    local id tok
    for id in "${APP_IDS[@]}"; do
        for tok in ${APP_SRC[$id]}; do
            [[ $tok == file:* ]] || continue
            picked "$id" || app_packages_installed "$id" || rm -f "$HOME/${tok#file:}"
        done
    done
    # The manager itself, and a launcher entry for it.
    ln -sfn "$SRC/rice" "$HOME/.local/bin/rice"
    mkdir -p "$HOME/.local/share/applications"
    printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=Менеджер райса" \
        "Comment=Программы, обновление и починка hypr-rice" "Exec=kitty -e rice" "Icon=preferences-desktop" \
        "Terminal=false" "Categories=Settings;" > "$HOME/.local/share/applications/hypr-rice-manager.desktop"
    ok "${#FILES[@]} файлов"

    # Machine-specific files are never overwritten.
    if [ ! -f "$HOME/.config/hypr/monitors.lua" ]; then
        printf '%s\n' "-- Monitors of this machine (not part of hypr-rice). Every output at its preferred mode;" \
            "-- name outputs here for fixed layouts, see \`hyprctl monitors\`." \
            'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })' \
            > "$HOME/.config/hypr/monitors.lua"
    fi
    if [ ! -f "$HOME/.config/hypr/devices.lua" ]; then
        printf '%s\n' "-- Per-device input settings. mouse-sens rewrites the sensitivity lines below," \
            "-- keep each hl.device() call on a single line." > "$HOME/.config/hypr/devices.lua"
    fi
    xdg-user-dirs-update 2>/dev/null || true
    mkdir -p "$HOME/Pictures/screenshots"
}

# What setup_system puts outside ~; teardown_system takes it away again.
THEME_ROOT=/usr/local/bin/hypr-theme-root
SUDOERS_RULE=/etc/sudoers.d/hypr-theme
TMPFILES_D=/etc/tmpfiles.d

setup_system() {
    fill_home "$SRC/system/hypr-theme-root" | sudo tee "$THEME_ROOT" >/dev/null
    sudo chmod 755 "$THEME_ROOT"
    local tmp
    tmp=$(mktemp)
    echo "$USER ALL=(root) NOPASSWD: $THEME_ROOT" > "$tmp"
    if sudo visudo -cqf "$tmp"; then
        sudo install -m 440 -o root -g root "$tmp" "$SUDOERS_RULE"
        ok "hypr-theme-root (цвет папок, экран входа, тема браузеров)"
    else
        warn "правило sudoers не прошло проверку, смена цвета папок и SDDM работать не будет"
    fi
    rm -f "$tmp"

    setup_sddm

    if ls /sys/bus/platform/drivers/ideapad_acpi/*/fn_lock >/dev/null 2>&1; then
        sudo install -Dm644 "$SRC/system/fn-lock.conf" "$TMPFILES_D/fn-lock.conf"
        sudo systemd-tmpfiles --create "$TMPFILES_D/fn-lock.conf" 2>/dev/null || true
        ok "Lenovo IdeaPad: Fn Lock включён"
    fi
    local s u
    for s in NetworkManager bluetooth; do
        sudo systemctl enable "$s.service" >/dev/null 2>&1 || warn "не включился $s"
    done
    systemctl --user daemon-reload 2>/dev/null || true
    # histuid and portal-restart are started by Hyprland itself (another desktop on the same
    # account has its own notification daemon); older installs enabled them globally.
    systemctl --user disable histuid.service portal-restart.timer >/dev/null 2>&1 || true
    for u in pipewire.socket pipewire-pulse.socket wireplumber.service; do
        systemctl --user enable "$u" >/dev/null 2>&1 || warn "не включился $u (включи после входа: systemctl --user enable $u)"
    done
    ok "сервисы"

    # GTK, icons, cursor. settings.ini covers GTK apps; gsettings covers portals and libadwaita.
    local gtk=Graphite-Dark
    [ -d /usr/share/themes/Graphite-Dark ] || gtk=Adwaita-dark
    gs() { dbus-run-session gsettings set org.gnome.desktop.interface "$@" 2>/dev/null \
               || gsettings set org.gnome.desktop.interface "$@" 2>/dev/null || true; }
    gs gtk-theme "$gtk"
    gs icon-theme Papirus-Dark
    gs cursor-theme WhiteCat
    gs cursor-size 24
    gs color-scheme prefer-dark
    sed -i "s/^gtk-theme-name=.*/gtk-theme-name=$gtk/" "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini" 2>/dev/null || true
    ok "GTK: $gtk, Papirus-Dark, курсор WhiteCat"
}

CACHE_TRIM=/usr/local/bin/rice-cache-trim
CACHE_TRIM_HOOK=/etc/pacman.d/hooks/rice-cache-trim.hook

setup_maintenance() {  # package caches kept under 200 MB, weekly TRIM for SSDs, the daily rice doctor
    sudo install -m755 "$SRC/system/rice-cache-trim" "$CACHE_TRIM"
    sudo install -Dm644 "$SRC/system/rice-cache-trim.hook" "$CACHE_TRIM_HOOK"
    systemctl --user enable cache-trim.timer >/dev/null 2>&1 || warn "не включился cache-trim.timer"
    systemctl --user enable rice-doctor.timer >/dev/null 2>&1 || warn "не включился rice-doctor.timer"
    sudo systemctl enable fstrim.timer >/dev/null 2>&1 || warn "не включился fstrim.timer"
    ok "кэш пакетов не больше 200 МБ, TRIM для SSD раз в неделю, проверка системы раз в день"
}

# The mirror of setup_system, setup_maintenance and setup_pkg_repo, for uninstall. SDDM itself, its
# theme package and fstrim stay: the machine needs some login screen, and TRIM does no harm.
teardown_system() {
    local f conf
    sudo rm -f "$SUDOERS_RULE" "$THEME_ROOT" "$CACHE_TRIM" "$CACHE_TRIM_HOOK" "$SDDM_CONF_D/99-hypr-rice.conf" \
        "$TMPFILES_D/hypr-rice-power.conf" "$TMPFILES_D/hypr-rice-battery.conf"
    systemctl --user disable --now cache-trim.timer rice-doctor.timer >/dev/null 2>&1 || true
    if cmp -s "$TMPFILES_D/fn-lock.conf" "$SRC/system/fn-lock.conf"; then sudo rm -f "$TMPFILES_D/fn-lock.conf"; fi
    # hypr-theme-root writes this one when no theme was set at all.
    if cmp -s "$SDDM_CONF_D/10-theme.conf" "$SRC/system/sddm-theme.conf"; then sudo rm -f "$SDDM_CONF_D/10-theme.conf"; fi
    # SDDM files the rice changed (theme, autologin), and the mirror list it put fallback mirrors in.
    for f in "$SDDM_CONF.rice-backup" "$SDDM_CONF_D"/*.rice-backup "$MIRRORLIST.rice-backup"; do
        [ -f "$f" ] || continue
        sudo mv "$f" "${f%.rice-backup}"
    done
    if pkg_repo_enabled; then
        conf=$(awk '/^\[/ { skip = ($0 == "[hypr-rice]") } !skip' "$PACMAN_CONF")
        printf '%s\n' "$conf" | sudo tee "$PACMAN_CONF" >/dev/null
        sudo pacman-key --delete "$PKG_KEY_FPR" >/dev/null 2>&1 || true
        info "репозиторий hypr-rice отключён; поставленные из него пакеты остались"
    fi
    ok "системные файлы райса убраны (SDDM остался экраном входа, с обычной темой)"
}

setup_apps_config() {
    if command -v code-oss >/dev/null; then
        local ext
        for ext in mhutchie.git-graph MS-CEINTL.vscode-language-pack-ru; do
            code-oss --install-extension "$ext" --force >/dev/null 2>&1 || warn "Code-OSS: не встало $ext"
        done
        ok "Code-OSS: Git Graph, русский язык"
    fi
    mkdir -p "$HOME/.claude"
    local cfg="$HOME/.claude/settings.json"
    if [ -f "$cfg" ]; then
        jq '.statusLine = {type: "command", command: "~/.claude/statusline.sh"}' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
    else
        echo '{ "statusLine": { "type": "command", "command": "~/.claude/statusline.sh" } }' | jq . > "$cfg"
    fi
    python3 "$HOME/.config/hypr/scripts/themegen.py" build >/dev/null 2>&1 \
        || warn "themegen build завершился с ошибкой (python3 ~/.config/hypr/scripts/themegen.py build)"
    ok "темы приложений"
}

apply_theme() {
    local theme=$1
    dbus-run-session "$HOME/.local/bin/changetheme" --offline "$theme" >/dev/null 2>&1 \
        || "$HOME/.local/bin/changetheme" --offline "$theme" >/dev/null 2>&1 \
        || warn "changetheme --offline $theme не отработал, после входа выполни: changetheme $theme"
    ok "тема $theme (менять: Alt+Shift+T или changetheme <тема>)"
}

finish() {
    step "Готово"
    [ "${DO_BACKUP:-0}" = 1 ] && info "Старые файлы: $BACKUP"
    if [ ${#WARNINGS[@]} -gt 0 ]; then
        printf '    %sПредупреждения:%s\n' "$YEL" "$R"
        printf '      - %s\n' "${WARNINGS[@]}"
        info "Если что-то не так: rice report — и пришли файл ~/rice-report.txt"
    fi
}

choose_mode() {  # replace | coexist | cancel
    if [ -n "${RICE_ASSUME:-}" ]; then
        [[ $RICE_ASSUME =~ ^[Yy] ]] && echo replace || echo cancel
        return
    fi
    choose_one "Что сделать со старым райсом?" \
        "Заменить: старый уйдёт в бэкап=replace" \
        "Поставить рядом: выбор окружения на экране входа=coexist" \
        "Отмена=cancel" || echo cancel
}

coexist_dm_question() {
    local cur
    cur=$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" .service 2>/dev/null || true)
    if [ -n "$cur" ] && [ "$cur" != sddm ]; then
        ask "Сейчас экран входа — $cur. Поставить вместо него SDDM hypr-rice (с темой райса)?" n \
            || USE_SDDM=0
    fi
}

# ---------- commands ----------

# Decides what happens to the configs already in ~ (sets MODE, DO_BACKUP, found[]). Only a first
# install backs anything up: later runs replace the rice's own files, and the user's other
# configs (kitty, waybar of another desktop) are none of their business.
inspect_existing_desktop() {
    local d p
    found=()
    MODE=${RICE_MODE:-}
    DO_BACKUP=0
    USE_SDDM=1
    if [ -f "$MARKER" ]; then
        info "hypr-rice уже установлен ($(cat "$MARKER")). Файлы райса обновятся, остальное не тронется."
        ask "Продолжить?" y || die "отменено"
        MODE=${MODE:-$(install_setting mode)}
        MODE=${MODE:-replace}
        return
    fi
    for d in "${RICE_DIRS[@]}"; do
        p="$HOME/.config/$d"
        [ -e "$p" ] && [ -n "$(ls -A "$p" 2>/dev/null)" ] && found+=("$p")
    done
    if [ ${#found[@]} -eq 0 ]; then
        ok "система чистая"
        MODE=${MODE:-replace}
        return
    fi
    info "Найден уже настроенный рабочий стол:"
    printf '      %s\n' "${found[@]}"
    [ -n "$MODE" ] || MODE=$(choose_mode)
    case "$MODE" in
        replace) info "Старый райс уйдёт в бэкап $BACKUP, вместо него встанет hypr-rice." ;;
        coexist)
            info "hypr-rice встанет рядом: настройки другого окружения не трогаются,"
            info "выбор между ними — на экране входа."
            [ -d "$HOME/.config/hypr" ] && info "Только чужой конфиг Hyprland уйдёт в бэкап: два райса в одном Hyprland не уживаются."
            coexist_dm_question ;;
        *) die "отменено, ничего не изменено" ;;
    esac
    DO_BACKUP=1
}

install_setting() {  # install_setting KEY: a value from install.conf, empty when unset
    sed -n "s/^$1=//p" "$HOME/.config/hypr-rice/install.conf" 2>/dev/null || true
}

# Remembers the install: the version, the mode, and the backup that uninstall puts back.
record_install() {
    local backup
    backup=$(install_setting backup)
    [ "${DO_BACKUP:-0}" = 1 ] && backup=$BACKUP
    echo "$(git -C "$SRC" log -1 --format='%h %cs' 2>/dev/null || echo local) $STAMP" > "$MARKER"
    mkdir -p "$HOME/.config/hypr-rice"
    printf '%s\n' "mode=$MODE" ${backup:+"backup=$backup"} > "$HOME/.config/hypr-rice/install.conf"
    [ -f "$TRUST" ] || install -m644 "$SRC/system/allowed_signers" "$TRUST"
}

# The part of an install that a rice update repeats: files, system settings, app themes.
apply_rice() {
    local theme=$1
    step "Файлы райса"
    copy_rice_files
    update_release_files

    step "Системные настройки"
    setup_system
    setup_maintenance

    step "Приложения"
    setup_apps_config

    step "Тема"
    apply_theme "$theme"
    record_install
}

cmd_install() {
    local theme="${RICE_THEME:-$(cat "$HOME/.config/hypr/current-theme" 2>/dev/null || echo claude)}"
    need_sudo
    load_apps

    step "Вопросы (дальше всё пойдёт само)"
    inspect_existing_desktop
    pick_apps install

    step "Пакеты из официальных репозиториев"
    local base=()
    mapfile -t base < <(list "$SRC/packages/base.txt")
    # pipewire-pulse replaces PulseAudio; --noconfirm would answer "no" to removing it and abort.
    if pacman -Qq pulseaudio >/dev/null 2>&1; then
        local pa=()
        mapfile -t pa < <(pacman -Qq | grep -E '^pulseaudio(-|$)')
        sudo pacman -Rdd --noconfirm "${pa[@]}" >/dev/null
        info "PulseAudio заменён на PipeWire"
    fi
    pac -Syu --needed "${base[@]}" || die "не удалось поставить основные пакеты (интернет или зеркала)"
    ok "${#base[@]} пакетов"

    step "Пакеты AUR"
    setup_pkg_repo
    local aur=()
    mapfile -t aur < <(list "$SRC/packages/aur.txt")
    aur_install "${aur[@]}" || true
    mark_rice_packages_explicit
    ok "готово"

    if [ ${#PICKED[@]} -gt 0 ]; then
        step "Выбранные программы"
        install_apps
    fi

    apply_rice "$theme"
    finish
    info "Перезагрузись и выбери сеанс Hyprland на экране входа."
    info "Alt+F1 — справка по хоткеям, Alt+R — лаунчер, Alt+Enter — терминал, rice — менеджер райса."
    # Never reboot on RICE_ASSUME alone: an unattended run should leave that to the caller.
    if [ -z "${RICE_ASSUME:-}" ] && ask "Перезагрузить сейчас?" n; then
        sudo systemctl reboot
    fi
}

cmd_apps() {
    need_sudo
    load_apps
    step "Программы"
    pick_apps install
    # Ticked but already present = nothing to do; only what is missing gets installed.
    local id todo=()
    for id in "${PICKED[@]}"; do app_installed "$id" || todo+=("$id"); done
    PICKED=("${todo[@]}")
    [ ${#PICKED[@]} -gt 0 ] || { ok "всё отмеченное уже установлено"; return; }
    pkg_repo_enabled || setup_pkg_repo
    install_apps
    # Themes for apps that just appeared (Code-OSS, AyuGram, ...).
    python3 "$HOME/.config/hypr/scripts/themegen.py" build >/dev/null 2>&1 || true
    finish
}

cmd_remove() {
    need_sudo
    load_apps
    step "Удаление программ"
    pick_apps remove
    [ ${#PICKED[@]} -gt 0 ] || return 0
    ask "Удалить: $(for id in "${PICKED[@]}"; do printf '%s, ' "${APP_NAME[$id]}"; done | sed 's/, $//')?" n || return 0
    remove_apps
    finish
}

# Installs from before signed updates have no TRUST yet; it is written at the end of their next install.
# install.sh has its own copy: it checks the download before running anything from it, this file included.
signed_by_author() {  # signed_by_author REV
    [ -f "$TRUST" ] || return 0
    git -C "$SRC" -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$TRUST" verify-commit "$1" >/dev/null 2>&1
}

cmd_update() {
    step "Обновляю hypr-rice"
    # An explicit refspec: the clone is single-branch, and RICE_BRANCH may name another branch.
    git -C "$SRC" fetch -q --depth 1 origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" \
        || die "не удалось скачать обновление с GitHub"
    signed_by_author "origin/$BRANCH" || die "новая версия на GitHub не подписана ключом автора, обновление не применено.
    Если автор сменил ключ и сам об этом сказал: rm $TRUST и снова rice update."
    local before after
    before=$(git -C "$SRC" rev-parse --short HEAD)
    # As a branch of that name, so the next update follows it too (BRANCH is read from HEAD).
    git -C "$SRC" checkout -q -f -B "$BRANCH" "origin/$BRANCH"
    after=$(git -C "$SRC" rev-parse --short HEAD)
    if [ "$before" = "$after" ] && [ -z "${RICE_FORCE:-}" ]; then
        ok "уже последняя версия ($after)"
        return
    fi
    ok "$before → $after"
    git -C "$SRC" log --format='      %s' "$before..$after" 2>/dev/null | head -n 15 || true
    # The new rice script may differ from the running one; let it apply the update.
    exec "$SRC/rice" apply-update
}

# What an update needs: the packages the new version added, its files, its settings. The system
# itself is not upgraded here, that is `rice upgrade`.
cmd_apply_update() {
    need_sudo
    load_apps
    MODE=$(install_setting mode)
    MODE=${MODE:-replace}
    DO_BACKUP=0
    PICKED=()

    step "Новые пакеты райса"
    install_missing_packages
    apply_rice "$(cat "$HOME/.config/hypr/current-theme" 2>/dev/null || echo claude)"
    rerun_installed_hooks
    finish
}

# The rice's packages count as installed on purpose: one that was already there as some program's
# dependency would otherwise go with that program (pacman -Rs, or a cleanup of orphans), screenshots
# and the theme generator with it.
mark_rice_packages_explicit() {
    local wanted=() installed=()
    mapfile -t wanted < <(list "$SRC/packages/base.txt"; list "$SRC/packages/aur.txt")
    mapfile -t installed < <(pacman -Qq "${wanted[@]}" 2>/dev/null || true)
    [ ${#installed[@]} -eq 0 ] || sudo pacman -D --asexplicit "${installed[@]}" >/dev/null || true
}

install_missing_packages() {
    local packages=() missing=() aur=()
    mapfile -t packages < <(list "$SRC/packages/base.txt")
    mapfile -t missing < <(pacman -T "${packages[@]}" 2>/dev/null || true)
    mapfile -t aur < <(list "$SRC/packages/aur.txt")
    # Without -y: syncing the databases without upgrading would leave a partial upgrade.
    if [ ${#missing[@]} -gt 0 ] && ! pac -S --needed "${missing[@]}"; then
        warn "не встали новые пакеты: ${missing[*]}. Поставятся с обновлением системы: rice upgrade"
    elif aur_install "${aur[@]}"; then
        ok "все пакеты райса на месте"
    fi
    forget_installed
    mark_rice_packages_explicit
}

STEAM_DIR="$HOME/.local/share/Steam"

proton_versions() {  # "name=path" for every Proton here: downloaded (ProtonPlus, umu), then Steam's own
    local dir library
    for dir in "$STEAM_DIR/compatibilitytools.d"/*/; do
        if [ -f "$dir/proton" ]; then
            echo "$(basename "$dir")=${dir%/}"
        fi
    done
    # Steam keeps its own Proton versions next to the games, in each of its library folders.
    while IFS= read -r library; do
        for dir in "$library/steamapps/common"/Proton*/; do
            if [ -f "$dir/proton" ]; then
                echo "$(basename "$dir") (Steam)=${dir%/}"
            fi
        done
    done < <(sed -n 's/^\s*"path"\s*"\(.*\)"\s*$/\1/p' "$STEAM_DIR/steamapps/libraryfolders.vdf" 2>/dev/null)
}

# ---------- games: optimisations, each on or off (rice games) ----------
# What is on is read from the system itself, not from a list of its own that could drift from it.
GAMEMODE_MARK="$HOME/.config/hypr-rice/gamemode"  # proton-run and the games window start games through gamemoderun
GAMEMODE_INI="$HOME/.config/gamemode.ini"
TEARING_LUA="$HOME/.config/hypr/games.lua"        # hyprland.lua loads it
NTSYNC_LOAD=/etc/modules-load.d/ntsync.conf
NTSYNC_RULE=/etc/udev/rules.d/60-ntsync.rules
GAME_TUNINGS=("GameMode во время игр=gamemode" "NTSync для Proton (опыт)=ntsync"
              "Тиринг в полноэкранных играх=tearing" "Ядро linux-zen=zen")

tuning_on() {  # tuning_on gamemode|ntsync|tearing|zen
    case "$1" in
        gamemode) [ -f "$GAMEMODE_MARK" ] ;;
        ntsync) [ -f "$NTSYNC_LOAD" ] ;;
        tearing) [ -f "$TEARING_LUA" ] ;;
        zen) pacman -Q linux-zen >/dev/null 2>&1 ;;
    esac
}

cmd_games() {
    local label out on=() chosen=()
    step "Игры: оптимизация"
    info "GameMode — на время игры: приоритет процессора и диска, режим «производительность», высокие частоты"
    info "    видеокарты AMD; после игры всё как было. Ноутбук греется сильнее."
    info "NTSync — модуль ядра для Proton. Опыт: где-то быстрее, где-то медленнее fsync, сравни на своих играх."
    info "Тиринг — полноэкранные игры без ожидания кадра: меньше задержка ввода, но видны разрывы кадра."
    info "linux-zen — второе ядро (выбор в меню GRUB), прирост на ноутбуках не доказан, ~150 МБ."
    for label in "${GAME_TUNINGS[@]}"; do
        if tuning_on "${label##*=}"; then on+=("${label%=*}"); fi
    done
    have_tty || die "нужен терминал: rice games спрашивает, что включить"
    out=$(choose_many "Что включить?" "$(IFS=,; echo "${on[*]}")" \
        "${GAME_TUNINGS[@]}") || return 0
    mapfile -t chosen <<<"$out"
    apply_game_tunings "${chosen[@]}"
}

apply_game_tunings() {  # apply_game_tunings ID...: those on, the others off; only what changes is touched
    local label id
    for label in "${GAME_TUNINGS[@]}"; do
        id=${label##*=}
        if printf '%s\n' "$@" | grep -qx "$id"; then
            tuning_on "$id" || "tuning_${id}_on" || warn "не включилось: ${label%=*}"
        elif tuning_on "$id"; then
            "tuning_${id}_off" || warn "не выключилось: ${label%=*}"
        fi
    done
}

tuning_gamemode_on() {
    need_sudo
    pac -S --needed gamemode || return 1
    enable_multilib || return 1
    pac -S --needed lib32-gamemode || warn "32-битная часть gamemode не встала: старые 32-битные игры пойдут без него"
    # The group lets gamemode raise priorities and switch CPU and GPU clocks without a password.
    sudo usermod -aG gamemode "$USER" || return 1
    write_gamemode_ini || return 1
    mkdir -p "$(dirname "$GAMEMODE_MARK")" || return 1
    touch "$GAMEMODE_MARK" || return 1
    ok "GameMode включён; права группы gamemode заработают после нового входа в систему"
    info "игры Steam: в свойствах игры, параметры запуска — gamemoderun %command%"
}

tuning_gamemode_off() {
    rm -f "$GAMEMODE_MARK"
    if grep -q '^# hypr-rice' "$GAMEMODE_INI" 2>/dev/null; then rm -f "$GAMEMODE_INI"; fi
    ok "GameMode выключен (пакет остался)"
}

# gamemode's own settings, unless the user keeps a gamemode.ini of their own.
write_gamemode_ini() {
    if [ -f "$GAMEMODE_INI" ] && ! grep -q '^# hypr-rice' "$GAMEMODE_INI"; then
        info "свой $GAMEMODE_INI оставлен как есть"
        return
    fi
    local card
    {
        echo "# hypr-rice (rice → Игры: оптимизация); rice removes it when GameMode is switched off."
        printf '[general]\nrenice=10\nioprio=0\ninhibit_screensaver=1\n'
        # The GPU part only for an AMD card: amd_performance_level is all gamemode does for it.
        if card=$(amd_card); then
            printf '\n[gpu]\napply_gpu_optimisations=accept-responsibility\ngpu_device=%s\namd_performance_level=high\n' "$card"
        fi
    } > "$GAMEMODE_INI"
}

amd_card() {  # the number N of the first /sys/class/drm/cardN run by amdgpu
    local card
    for card in /sys/class/drm/card[0-9]*; do
        if [ "$(basename "$(readlink -f "$card/device/driver")")" = amdgpu ]; then
            echo "${card##*card}"
            return 0
        fi
    done
    return 1
}

tuning_ntsync_on() {
    need_sudo
    echo ntsync | sudo tee "$NTSYNC_LOAD" >/dev/null || return 1
    # The device is root's only otherwise; uaccess gives it to whoever sits at the machine.
    echo 'KERNEL=="ntsync", TAG+="uaccess"' | sudo tee "$NTSYNC_RULE" >/dev/null || return 1
    sudo udevadm control --reload || return 1
    sudo modprobe ntsync || { warn "модуль ntsync не загрузился (в этом ядре его нет?)"; return 1; }
    ok "NTSync включён: Proton через proton-run берёт его сам (PROTON_USE_NTSYNC)"
}

tuning_ntsync_off() {
    need_sudo
    sudo rm -f "$NTSYNC_LOAD" "$NTSYNC_RULE" || return 1
    sudo udevadm control --reload || return 1
    sudo modprobe -r ntsync 2>/dev/null || info "ntsync сейчас занят игрой: выгрузится после перезагрузки"
    ok "NTSync выключен"
}

tuning_tearing_on() {
    mkdir -p "$(dirname "$TEARING_LUA")" || return 1
    cat > "$TEARING_LUA" <<'LUA' || return 1
-- Тиринг в полноэкранных играх (rice → Игры: оптимизация); rice writes and removes this file.
-- Hyprland shows such a game's frame at once instead of waiting for the screen: less input lag, with
-- tearing. Games run on XWayland (Proton, Steam, Wine) or are osu!; browsers and video players are
-- native Wayland windows and keep whole frames.
hl.config({ general = { allow_tearing = true } })

hl.window_rule({
    name  = "games-tearing",
    match = { fullscreen = true, xwayland = true },

    immediate = true,
})

hl.window_rule({
    name  = "games-tearing-osu",
    match = { fullscreen = true, class = "^osu!$" },

    immediate = true,
})
LUA
    hyprctl reload >/dev/null 2>&1 || true
    ok "тиринг в полноэкранных играх включён"
}

tuning_tearing_off() {
    rm -f "$TEARING_LUA"
    hyprctl reload >/dev/null 2>&1 || true
    ok "тиринг выключен"
}

tuning_zen_on() {
    need_sudo
    local free_mb
    free_mb=$(df --output=avail -m / | tail -n1)
    [ "$free_mb" -ge 1000 ] || { warn "на / свободно ${free_mb} МБ, для ядра нужно ~1000"; return 1; }
    pac -S --needed linux-zen || return 1
    update_grub
    ok "linux-zen поставлен; linux остался. Какое ядро грузится сейчас: uname -r; другое — в меню GRUB (Advanced options)"
}

tuning_zen_off() {
    case "$(uname -r)" in
        *zen*) warn "сейчас загружено linux-zen: перезагрузись в linux, потом выключай"; return 1 ;;
    esac
    need_sudo
    sudo pacman -Rns --noconfirm linux-zen || return 1
    update_grub
    ok "linux-zen удалён"
}

update_grub() {
    if [ -f /boot/grub/grub.cfg ] && command -v grub-mkconfig >/dev/null; then
        sudo grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || warn "grub-mkconfig не отработал: меню загрузки не обновлено"
    else
        warn "загрузчик не GRUB: меню загрузки обнови сам"
    fi
}

cmd_proton() {  # which Proton runs .exe files (proton-run reads ~/.config/hypr-rice/proton.conf)
    local conf="$HOME/.config/hypr-rice/proton.conf"
    local current choice found=()
    local options=("Автоматически: последняя UMU-Proton=auto")
    mapfile -t found < <(proton_versions)
    options+=("${found[@]}")
    step "Proton для .exe"
    current=$(sed -n 's/^proton=//p' "$conf" 2>/dev/null || true)
    if [ -n "$current" ]; then
        info "сейчас: $(basename "$current")"
    else
        info "сейчас: автоматически (последняя UMU-Proton)"
    fi
    [ ${#options[@]} -gt 1 ] || info "других версий нет; поставь их в ProtonPlus (раздел Steam), они появятся здесь"
    have_tty || die "нужен терминал: rice proton спрашивает, какую версию взять"
    choice=$(choose_one "Какой Proton запускает .exe?" "${options[@]}") || return 0
    mkdir -p "$(dirname "$conf")"
    if [ "$choice" = auto ]; then
        rm -f "$conf"
        ok "автоматически: последняя UMU-Proton"
    else
        echo "proton=$choice" > "$conf"
        ok "$(basename "$choice")"
    fi
}

cmd_upgrade() {
    need_sudo
    step "Обновление системы"
    pkg_repo_enabled || setup_pkg_repo
    pac -Syu || die "pacman -Syu не прошёл"
    ok "официальные репозитории и hypr-rice"
    # AUR packages that are not in the hypr-rice repo: -Qm lists only packages no enabled repo has,
    # and the hypr-rice repo is one of them, so its packages were upgraded by -Syu above.
    local foreign=()
    mapfile -t foreign < <(pacman -Qqm)
    if [ ${#foreign[@]} -gt 0 ] && aur_reachable && command -v yay >/dev/null; then
        yay -Sua --noconfirm --answerdiff None --answerclean None || warn "часть AUR-пакетов не обновилась"
    elif [ ${#foreign[@]} -gt 0 ]; then
        info "AUR недоступен; пакеты не из репозитория hypr-rice не обновлены: ${foreign[*]}"
    fi
    command -v flatpak >/dev/null && flatpak update --user -y --noninteractive >/dev/null 2>&1 || true
    finish
}

cmd_repair() {
    need_sudo
    step "Починка"
    local base=() aur=()
    mapfile -t base < <(list "$SRC/packages/base.txt")
    mapfile -t aur < <(list "$SRC/packages/aur.txt")
    pac -S --needed "${base[@]}" >/dev/null || warn "не все основные пакеты встали"
    pkg_repo_enabled || setup_pkg_repo
    aur_install "${aur[@]}" || true
    mark_rice_packages_explicit
    setup_system
    setup_maintenance
    apply_theme "$(cat "$HOME/.config/hypr/current-theme" 2>/dev/null || echo claude)"
    finish
}

cmd_report() {
    local out="$HOME/rice-report.txt"
    # Every section is written whatever fails before it: a broken system is what the report is for,
    # and under set -e the first missing file or stopped service would end it there.
    (
        set +e
        echo "hypr-rice report $(date '+%F %T')"
        echo "rice: $(cat "$MARKER" 2>/dev/null || echo 'не установлен')  src: $(git -C "$SRC" log -1 --format='%h %s' 2>/dev/null)"
        echo "os: $(. /etc/os-release; echo "$PRETTY_NAME")  kernel: $(uname -r)"
        echo "gpu: $(for v in /sys/class/drm/card*/device/vendor; do cat "$v"; done 2>/dev/null | sort -u | tr '\n' ' ')"
        echo
        echo "== display manager"
        readlink -f /etc/systemd/system/display-manager.service 2>&1
        systemctl is-enabled sddm 2>&1; systemctl is-active sddm 2>&1
        cat /etc/sddm.conf.d/*.conf 2>/dev/null
        echo
        echo "== sddm log"
        journalctl -b -u sddm --no-pager 2>/dev/null | tail -n 40
        echo
        echo "== sessions"
        ls /usr/share/wayland-sessions /usr/share/xsessions 2>/dev/null
        echo
        echo "== missing rice packages"
        local p
        for p in $(list "$SRC/packages/base.txt") $(list "$SRC/packages/aur.txt"); do
            pacman -Qq "$p" >/dev/null 2>&1 || echo "  $p"
        done
        echo
        echo "== network"
        for u in https://github.com https://aur.archlinux.org "$PKG_REPO_URL/hypr-rice.db" https://geo.mirror.pkgbuild.com; do
            printf '  %-70s %s\n' "$u" "$(curl -fsSIL -o /dev/null -w '%{http_code}' --max-time 10 "$u" 2>&1 || echo FAIL)"
        done
        echo
        echo "== hyprland"
        hyprctl version 2>/dev/null | head -n 2 || echo "  не запущен"  # pipefail: the pipe fails when hyprctl does
        hyprctl configerrors 2>/dev/null
        echo
        echo "== user services"
        systemctl --user --no-pager --failed 2>/dev/null | head -n 20
        echo
        echo "== pacman.conf repos"
        grep -E '^\[' "$PACMAN_CONF"
    ) > "$out" 2>&1 || true
    ok "отчёт: $out (пришли его тому, кто помогает)"
}

cmd_doctor() {  # the doctor is python, next to this script (doctor/)
    PYTHONPATH="$SRC${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m doctor "$@"
}

# The backup taken when the rice was first installed, or nothing if it replaced no other configs.
# Installs from before install.conf kept it get the oldest backup that is not one of the rice
# itself (older versions also backed the rice up on every update; those have the install marker).
pre_rice_backup() {
    local backup
    backup=$(install_setting backup)
    if [ -n "$backup" ]; then
        [ -d "$backup" ] && echo "$backup"
        return 0
    fi
    while IFS= read -r backup; do
        [ -e "$backup/hypr/.rice-installed" ] || { echo "$backup"; return 0; }
    done < <(find "$HOME" -maxdepth 1 -name '.rice-backup-*' | sort)
}

cmd_uninstall() {
    local backup
    backup=$(pre_rice_backup)
    step "Удаление hypr-rice"
    if [ -n "$backup" ]; then
        info "будет возвращён бэкап: $backup"
    else
        info "бэкапа прежних настроек нет: файлы райса просто удалятся"
    fi
    ask "Удалить hypr-rice?" n || return 0
    need_sudo
    load_apps
    undo_program_steps
    # Before the files go: the user units it disables are among them.
    teardown_system

    local f
    while IFS= read -r f; do rm -f "$HOME/$f"; done < <(installed_rice_files)
    while read -r _ f; do rm -f "$HOME/$f"; done < "$SRC/packages/release.sha256"
    restore_merged_files
    unset_claude_statusline
    cd "$HOME"
    rm -f "$MARKER" "$HOME/.local/bin/rice" "$HOME/.local/share/applications/hypr-rice-manager.desktop" \
          "$HOME/.config/hypr-rice/install.conf" "$MANIFEST"
    if [ -n "$backup" ]; then
        # Foreign configs were moved as whole directories, ours file by file under home/.
        for f in "$backup"/*; do
            [ -e "$f" ] || continue  # an empty backup: the pattern stays as it is
            case "$(basename "$f")" in
                home) (cd "$backup/home" && tar -cf - .) | tar -C "$HOME" -xf - ;;
                hypr) mkdir -p "$HOME/.config/hypr" && cp -a "$f/." "$HOME/.config/hypr/" ;;
                *) [ -e "$HOME/.config/$(basename "$f")" ] || mv "$f" "$HOME/.config/" ;;
            esac
        done
        ok "возвращено из $backup"
    fi
    info "Пакеты остались; удалить их: sudo pacman -Rs <пакеты>"
}

installed_rice_files() {  # the files of ~ the rice put there, relative to ~
    if [ -f "$MANIFEST" ]; then
        cat "$MANIFEST"
        return
    fi
    # Installs from before the list: what this version ships, the merged files aside.
    local f
    while IFS= read -r -d '' f; do
        f=${f#./}
        is_merged "$f" || printf '%s\n' "$f"
    done < <(cd "$SRC/home" && find . -type f -print0 -o -type l -print0)
}

# The setup steps of installed programs and the game optimisations change the system (zram, earlyoom,
# the .exe rule in the kernel, AntiDPI, NTSync); without the rice nothing would manage them.
undo_program_steps() {
    local id tok
    for id in "${APP_IDS[@]}"; do
        app_packages_installed "$id" || continue
        for tok in ${APP_SRC[$id]}; do
            [[ $tok == hook:* ]] || continue
            run_unhook "${tok#hook:}" || warn "не отменился шаг ${tok#hook:}"
        done
    done
    # linux-zen stays: it may be the kernel running now.
    for id in gamemode ntsync tearing; do
        if tuning_on "$id"; then "tuning_${id}_off" || warn "не выключилось: $id"; fi
    done
}

restore_merged_files() {  # each merged file back to the user's own from before the rice
    local path saved
    for path in "${MERGED_JSON[@]}"; do
        saved="$ORIGINALS/$path"
        if [ -f "$saved" ]; then
            [ -f "$HOME/$path" ] && cp -a "$HOME/$path" "$HOME/$path.rice-backup"
            mkdir -p "$(dirname "$HOME/$path")"
            mv "$saved" "$HOME/$path"
            ok "$path: возвращён твой прежний (с райсом — $path.rice-backup)"
        elif [ -e "$saved.absent" ] && cmp -s "$HOME/$path" "$SRC/home/$path"; then
            rm -f "$HOME/$path"
        elif [ -e "$HOME/$path" ]; then
            info "$path оставлен: в нём твои настройки вместе с настройками райса"
        fi
        rm -f "$saved.absent"
    done
    find "$ORIGINALS" -depth -type d -empty -delete 2>/dev/null || true
}

unset_claude_statusline() {  # setup_apps_config pointed Claude Code's status line at the rice's script
    local cfg="$HOME/.claude/settings.json"
    [ -f "$cfg" ] || return 0
    jq -e '.statusLine.command == "~/.claude/statusline.sh"' "$cfg" >/dev/null 2>&1 || return 0
    jq 'del(.statusLine)' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
}

# The launcher runs `kitty -e rice`: the menu stays until "Выход", and the output of every action
# stays on screen until Enter. Each action is a rice of its own, so its errors (die) end only it.
menu() {
    local choice
    have_tty || die "меню нужен терминал; команды: rice install|apps|remove|update|upgrade|proton|games|repair|report|doctor|uninstall"
    # Here, not in choose_one's $(...): a failed download is then neither repeated nor announced each round.
    fetch_gum || true
    while choice=$(choose_one "hypr-rice — что сделать?" \
            "Установить программы=apps" "Удалить программы=remove" "Обновить райс=update" \
            "Обновить систему и программы=upgrade" "Proton для .exe: версия=proton" \
            "Игры: оптимизация=games" \
            "Проверить систему=doctor" "Починить (SDDM, тема, сервисы)=repair" \
            "Отчёт для помощи=report" "Переустановить райс=install" "Удалить райс=uninstall" \
            "Выход=quit"); do
        case "$choice" in
            ""|quit) return 0 ;;
        esac
        if [ "$choice" = doctor ]; then
            "$SRC/rice" doctor --fix || true  # every cure is asked about first
        else
            "$SRC/rice" "$choice" || true
        fi
        echo
        read -r -p "    Enter — назад в меню " _ </dev/tty || return 0
    done
}

# The author's working copy (marked by an untracked .author): there the live configs are the
# source and home/ is synced from them, so install/update/uninstall would clobber unsynced work.
run() {
    case "$1" in
        install|update|apply_update|uninstall)
            if [ -e "$SRC/.author" ] && [ -z "${RICE_AUTHOR_OK:-}" ]; then
                die "это рабочая копия автора ($SRC): rice ${1//_/-} перезапишет живые конфиги и сбросит репозиторий. Если точно надо: RICE_AUTHOR_OK=1 rice ${1//_/-}"
            fi ;;
    esac
    "cmd_$1"
}

# Sourced by tests/run.sh for its functions; run as a command otherwise.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    case "${1:-}" in
        install|apps|remove|update|upgrade|proton|games|repair|report|uninstall) run "$1" ;;
        apply-update) run apply_update ;;  # run by `rice update` from the freshly fetched script
        doctor) shift; cmd_doctor "$@" ;;
        ""|menu) menu ;;
        -h|--help|help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
        *) die "неизвестная команда: $1 (rice help)" ;;
    esac
    # Bash reads a script as it runs it: past this point it would read whatever the file holds now,
    # and an update or an edit made while rice was running changes it under its feet.
    exit
fi
