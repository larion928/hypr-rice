#!/usr/bin/env bash
# rice — install and manage hypr-rice.
#
#   rice              menu
#   rice install      install or reinstall the rice (what install.sh runs)
#   rice apps         pick programs to install
#   rice remove       remove programs installed from the catalog
#   rice update       fetch the latest rice from GitHub and apply it (keeps theme and machine files)
#   rice upgrade      update the system, the hypr-rice repo and AUR programs
#   rice proton       pick the Proton version that runs .exe files
#   rice games        game optimisations, each on or off: GameMode, NTSync, tearing, linux-zen
#   rice repair       re-apply SDDM, GTK theme, services and features
#   rice features     the rice's features, on or off; rice features on|off <id> switches one
#   rice report       write ~/rice-report.txt for whoever helps you debug
#   rice mouse-test   the mouse's sensor angle (and the rotation that undoes it), resolution, polling rate
#   rice doctor       check the system and the rice; --fix [-y] cures, --full slow checks too (rice doctor -h)
#   rice uninstall    remove the rice and put the last backup back
#
# Environment: RICE_THEME, RICE_ASSUME=y|n, RICE_APPS=all|none|id,id, RICE_MODE=replace|coexist
# (see install.sh).
set -euo pipefail

# The repo this script is in, also when run through the ~/.local/bin/rice link: lib/ is next to it.
SRC=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
MARKER="$HOME/.config/hypr/.rice-installed"
CACHE="$HOME/.cache/hypr-rice"
# The author's commit signing key, remembered at the first install. It lives outside the repo, so a
# pushed change of system/allowed_signers cannot move the trust along with a malicious update.
TRUST="$HOME/.config/hypr-rice/allowed_signers"
# Not every login sets USER (a bare `su`, some containers); set -u would stop rice at its first use.
USER=${USER:-$(id -un)}

# All of it is read now, before any command runs: `rice update` replaces these files under a running
# rice, which then hands over to the new one (exec rice apply-update).
for lib in "$SRC"/lib/*.sh "$SRC"/lib/hooks/*.sh; do
    # shellcheck source=/dev/null
    source "$lib"
done

# The launcher runs `kitty -e rice`: the menu stays until "Выход", and the output of every action
# stays on screen until Enter. Each action is a rice of its own, so its errors (die) end only it.
menu() {
    local choice
    have_tty || die "меню нужен терминал; команды: rice install|apps|remove|update|upgrade|proton|games|repair|report|doctor|features|mouse-test|uninstall"
    # Here, not in choose_one's $(...): a failed download is then neither repeated nor announced each round.
    fetch_gum || true
    while choice=$(choose_one "hypr-rice — что сделать?" \
            "Установить программы=apps" "Удалить программы=remove" "Обновить райс=update" \
            "Обновить систему и программы=upgrade" "Proton для .exe: версия=proton" \
            "Игры: оптимизация=games" \
            "Проверить систему=doctor" "Мышь: угол датчика, DPI=mouse-test" \
            "Починить (SDDM, тема, сервисы)=repair" \
            "Отчёт для помощи=report" "Переустановить райс=install" "Удалить райс=uninstall" \
            "Выход=quit"); do
        case "$choice" in
            ""|quit) return 0 ;;
        esac
        if [ "$choice" = doctor ]; then
            "$SRC/rice" doctor --fix || true  # every cure is asked about first
        else
            "$SRC/rice" "$choice" || true
        fi
        echo
        read -r -p "    Enter — назад в меню " _ </dev/tty || return 0
    done
}

# The author's working copy (marked by an untracked .author): there the live configs are the
# source and home/ is synced from them, so install/update/uninstall would clobber unsynced work.
run() {
    case "$1" in
        install|update|apply_update|uninstall)
            if [ -e "$SRC/.author" ] && [ -z "${RICE_AUTHOR_OK:-}" ]; then
                die "это рабочая копия автора ($SRC): rice ${1//_/-} перезапишет живые конфиги и сбросит репозиторий. Если точно надо: RICE_AUTHOR_OK=1 rice ${1//_/-}"
            fi ;;
    esac
    "cmd_$1"
}

# Sourced by tests/lib.sh for its functions; run as a command otherwise.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    case "${1:-}" in
        install|apps|remove|update|upgrade|proton|games|repair|report|uninstall) run "$1" ;;
        apply-update) run apply_update ;;  # run by `rice update` from the freshly fetched script
        doctor) shift; cmd_doctor "$@" ;;
        features) shift; cmd_features "$@" ;;
        mouse-test) cmd_mouse_test ;;
        ""|menu) menu ;;
        -h|--help|help) sed -n '2,/^# Environment/{/^# Environment/!s/^# \{0,1\}//p}' "$0" ;;
        *) die "неизвестная команда: $1 (rice help)" ;;
    esac
    # Bash reads a script as it runs it: past this point it would read whatever the file holds now,
    # and an update or an edit made while rice was running changes it under its feet.
    exit
fi
